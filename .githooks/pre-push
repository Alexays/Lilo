#!/bin/sh
set -eu

# Opt-in: `make hooks-install-push-checks` sets lilo.hooks.pre-push; without it this hook does nothing.
[ "$(git config --bool lilo.hooks.pre-push 2> /dev/null || echo false)" = true ] || exit 0

# Deleting a branch has nothing to validate.
zero=0000000000000000000000000000000000000000
pushing=
while read -r _ local_sha _ _; do
    [ "$local_sha" = "$zero" ] || pushing=1
done
[ -n "$pushing" ] || exit 0

cd "$(git rev-parse --show-toplevel)"
lockfile=${LILO_TSC_LOCK:-/tmp/tsc.lock}
echo "pre-push: make validate under $lockfile, about 30 s warm (git push --no-verify skips it)" >&2
if command -v flock > /dev/null 2>&1; then lock="flock $lockfile"; else lock="lockf -k $lockfile"; fi
LILO_CHECK_TIER=pre-push LILO_CHECK_TRIGGER=hook $lock make --no-print-directory validate || {
    echo "pre-push: validate failed, so nothing was pushed; fix it, or git push --no-verify to push anyway (CI runs the same gate)" >&2
    exit 1
}
