{
  "name": "lilo-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && blume dev",
    "build": "npm run generate && blume build",
    "check": "npm run generate && blume validate --strict",
    "test": "blume audit",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "blume": "2.2.7"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
