---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
const lang = "en";
---
<Layout lang={lang} title="Page not found - Lilo" description="The link may be old, or mistyped." noindex>
<div class="top" style="min-height:100vh;min-height:100dvh;padding-bottom:0">
  <Header lang={lang} />
  <main id="main-content" class="wrap hero-copy" style="padding-block:12vh 72px">
    <img class="mark" src="/favicon.svg" alt="" width="128" height="128">
    <h1>This page<br><span>never bloomed.</span></h1>
    <p class="sub">The link may be old, or mistyped. Everything about Lilo is one click away.</p>
    <div class="cta">
      <a class="pill dark" href="/">Back to Lilo</a>
      <a class="pill soft" href="https://github.com/Alexays/Lilo/releases/latest/download/Lilo.dmg">Download for Mac</a>
    </div>
    <span class="move-in">Coming from another browser? <a href="/moving/">See how to move in</a></span>
    <span class="move-in" lang="fr">Page introuvable. <a href="/fr/">Accueil en français</a></span>
  </main>
</div>
</Layout>
