---
import PageSection from "../components/PageSection.astro";
import Layout from "../layouts/Layout.astro";
import { copy } from "../lib/i18n";

const lang = "en";
const text = copy[lang];
---

<Layout
  lang={lang}
  title="Page not found - Lilo"
  description="The link may be old, or mistyped."
  noindex
  hero={{
    heading: text.notFoundHeading,
    description: text.notFoundDescription,
    tag: "404",
    link: { href: "/", label: text.backToLilo },
  }}
>
  <PageSection>
    <div class="recovery-links">
      <p>
        Coming from another browser? <a href="/moving/">See how to move in</a>
      </p>
      <p lang="fr">
        Page introuvable. <a href="/fr/">Accueil en français</a>
      </p>
    </div>
  </PageSection>
</Layout>

<style>
  .recovery-links {
    display: grid;
    gap: 16px;
    color: var(--ink-2);
  }
  a {
    color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
