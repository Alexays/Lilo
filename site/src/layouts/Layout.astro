---
import config from "../../../Xcode/Configs/Base.xcconfig?raw";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

import "../styles/global.css";

interface Schema {
  "@type": string;
  softwareVersion?: string;
}

interface Props {
  lang: Locale;
  title: string;
  description: string;
  schema?: Schema[];
  noindex?: boolean;
}

const { lang, title, description, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const englishPath = path.replace(/^\/fr(?=\/)/u, "");
const canonical = new URL(path, Astro.site).href;
const english = new URL(englishPath, Astro.site).href;
const french = new URL(`/fr${englishPath}`, Astro.site).href;

const imageAlt =
  lang === "fr"
    ? "La fleur de Lilo avec les mots : Lilo, your internet, in bloom."
    : "The Lilo flower mark with the words: Lilo, your internet, in bloom.";

const version = config.match(/^MARKETING_VERSION = (?<version>\S+)$/mu)?.[1];

if (!version) {
  throw new Error("MARKETING_VERSION is missing from Base.xcconfig");
}

const graph = schema.map((node) =>
  node["@type"] === "SoftwareApplication"
    ? { ...node, softwareVersion: version }
    : node
);

const jsonLD = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={english} />
        <link rel="alternate" hreflang="fr" href={french} />
        <link rel="alternate" hreflang="x-default" href={english} />
        <link rel="alternate" type="text/markdown" href={`${path}index.md`} />
      </>
    )}
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#e3dafa"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#403a5b"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lilo" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "fr" ? "en_US" : "fr_FR"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://getlilo.app/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://getlilo.app/og.png" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/nunito-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {graph.length > 0 && (
      <script is:inline type="application/ld+json" set:html={jsonLD} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {copy[lang].skip}
    </a>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
