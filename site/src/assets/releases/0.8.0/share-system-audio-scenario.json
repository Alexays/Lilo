      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Morning light · Storyboard</title><style>*{box-sizing:border-box}body{margin:0;background:#f7f5ef;color:#243b36;font-family:system-ui,sans-serif;padding:48px}main{max-width:760px;margin:auto}.eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:#576f66}h1{font-size:42px;letter-spacing:-.04em;margin:18px 0 12px}p{font-size:17px;line-height:1.6;color:#576f66}.scene{margin-top:32px;height:230px;border-radius:20px;background:linear-gradient(145deg,#d9e8ce,#a9c8b2);display:flex;align-items:end;padding:28px}.scene span{font-size:26px;font-weight:600;letter-spacing:-.03em}.details{display:flex;gap:48px;margin-top:28px}.details p{font-size:14px}.details strong{display:block;color:#243b36;margin-bottom:5px}</style></head><body><main><div class=\"eyebrow\">Creative studio / Brand film</div><h1>Morning light</h1><p>A fresh start, told through small everyday moments.</p><div class=\"scene\"><span>Make room for a slower morning.</span></div><div class=\"details\"><p><strong>Picture</strong>Soft light. Natural movement.</p><p><strong>Sound</strong>Warm piano. A gentle rhythm.</p></div></main></body></html>",
