    {
      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Film review</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f7fa;color:#202d40;font-family:system-ui,sans-serif;padding:48px}main{max-width:680px;margin:auto}.eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:#65748a}h1{font-size:44px;letter-spacing:-.045em;margin:24px 0 14px}p{font-size:18px;line-height:1.6;color:#65748a;max-width:530px}.card{background:white;border:1px solid #e1e6ee;border-radius:22px;padding:30px;margin-top:32px}h2{font-size:21px;margin:0 0 10px}.card p{font-size:16px;margin:0 0 26px}button{font:600 16px system-ui,sans-serif;color:white;background:#365acb;border:0;border-radius:12px;padding:15px 22px;cursor:pointer}button:focus-visible{outline:3px solid #9bb4ff;outline-offset:4px}#status{font-size:14px;margin:20px 0 0;min-height:23px}video{display:block;width:100%;margin-top:24px;border-radius:14px}video[hidden]{display:none}</style></head><body><main><div class=\"eyebrow\">Creative studio / Review room</div><h1>See it. Hear it. Together.</h1><p>Review the picture, music and finishing touches for Morning light.</p><section class=\"card\"><h2>Bring the film into the review</h2><p>Choose a window or screen to present your work.</p><button id=\"share-screen\" type=\"button\">Share a window or screen</button><p id=\"status\" role=\"status\">Your presentation is ready when you are.</p><video id=\"preview\" autoplay muted playsinline hidden></video></section></main><script>const button=document.getElementById('share-screen');const status=document.getElementById('status');const preview=document.getElementById('preview');button.addEventListener('click',async()=>{try{const stream=await navigator.mediaDevices.getDisplayMedia({video:true,audio:true});preview.srcObject=stream;preview.hidden=false;status.textContent='Your selected source is being shared.';stream.getVideoTracks()[0].addEventListener('ended',()=>{preview.srcObject=null;preview.hidden=true;status.textContent='Sharing ended.';});}catch(error){status.textContent=error.name==='NotAllowedError'?'Sharing was cancelled.':'Sharing could not start.';}});</script></body></html>",
