      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Project brief</title><style>*{box-sizing:border-box}body{margin:0;background:#faf7f0;color:#27352e;font-family:system-ui,sans-serif;padding:48px}main{max-width:680px;margin:auto}.eyebrow{font-size:12px;font-weight:650;letter-spacing:.16em;color:#626d61}h1{font-size:48px;letter-spacing:-.05em;line-height:1.08;margin:28px 0 18px}p{font-size:19px;line-height:1.6;color:#566055;max-width:520px}.rule{height:1px;background:#d7ddce;margin:36px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}h2{font-size:15px;margin:0 0 12px}.grid p{font-size:16px;margin:0}.tag{display:inline-block;margin-top:34px;padding:9px 14px;border-radius:20px;background:#e6eddd;font-size:13px}</style></head><body><main><div class=\"eyebrow\">STUDIO NOTES / 01</div><h1>A little more room<br>for good ideas.</h1><p>A simpler workspace for the things that deserve your attention.</p><div class=\"rule\"></div><div class=\"grid\"><section><h2>The idea</h2><p>Bring the essentials together.<br>Give everything else some space.</p></section><section><h2>The next step</h2><p>Review the direction.<br>Choose what to explore first.</p></section></div><span class=\"tag\">Project brief</span></main></body></html>",
