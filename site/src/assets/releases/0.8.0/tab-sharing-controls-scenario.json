    {
      "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Presentation room</title><style>*{box-sizing:border-box}body{margin:0;background:#f8f9fb;color:#263349;font-family:system-ui,sans-serif;padding:32px}main{max-width:720px;margin:auto}.eyebrow{font-size:11px;font-weight:650;letter-spacing:.15em;color:#69758a}h1{font-size:32px;letter-spacing:-.04em;margin:14px 0 8px}.intro{font-size:15px;color:#687486;margin:0 0 22px}.stage{height:350px;position:relative;border:1px solid #dce2ea;border-radius:18px;overflow:hidden;background:#edf1f6}video{display:block;width:100%;height:100%;object-fit:contain;background:#edf1f6}.placeholder{position:absolute;inset:0;display:grid;place-content:center;text-align:center;pointer-events:none;color:#64738a}.placeholder[hidden]{display:none}.placeholder strong{font-size:20px;font-weight:550}.placeholder p{font-size:14px;line-height:1.6;margin:10px 0 0}.controls{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:22px}#status{font-size:14px;color:#52647b}button{font:600 14px system-ui;color:white;background:#355fc7;border:0;border-radius:10px;padding:13px 20px;cursor:pointer}button:disabled{background:#dfe5ef;color:#65758e;cursor:default}button:focus-visible{outline:3px solid #92b2ff;outline-offset:3px}#quiet{position:fixed;right:20px;bottom:16px;width:72px;height:30px}</style></head><body><main><div class=\"eyebrow\">STUDIO / LOCAL PRESENTATION</div><h1>Presentation room</h1><p class=\"intro\">Local preview · Camera and microphone off</p><div class=\"stage\"><video id=\"preview\" autoplay muted playsinline aria-label=\"Live preview of the shared tab\"></video><div id=\"placeholder\" class=\"placeholder\"><strong id=\"placeholder-title\">A clear view of your ideas.</strong><p>Choose a tab to preview your presentation.</p></div></div><div class=\"controls\"><span id=\"status\" role=\"status\">Ready to share</span><button id=\"share\" type=\"button\">Share a tab</button></div></main><div id=\"quiet\" aria-hidden=\"true\"></div><script>const preview=document.getElementById('preview');const share=document.getElementById('share');const status=document.getElementById('status');const placeholder=document.getElementById('placeholder');const placeholderTitle=document.getElementById('placeholder-title');let stream=null;function showStopped(){delete preview.dataset.live;preview.srcObject=null;placeholder.hidden=false;placeholderTitle.textContent='Your presentation is still open.';placeholder.querySelector('p').textContent='Share another tab whenever you’re ready.';status.textContent='Sharing stopped';share.disabled=false;}function endPresentation(){if(stream)stream.getTracks().forEach(track=>track.stop());stream=null;showStopped();}if(navigator.mediaSession){navigator.mediaSession.setActionHandler('hangup',endPresentation);}preview.addEventListener('loadeddata',()=>{if(stream&&stream.getVideoTracks()[0].readyState==='live'){placeholder.hidden=true;status.textContent='Sharing live';preview.dataset.live='true';}});share.addEventListener('click',async()=>{try{stream=await navigator.mediaDevices.getDisplayMedia({video:true,audio:false});share.disabled=true;const track=stream.getVideoTracks()[0];track.addEventListener('ended',()=>{stream=null;showStopped();},{once:true});preview.srcObject=stream;await preview.play();}catch(error){status.textContent=error.name==='NotAllowedError'?'Ready to share':'Unable to start sharing';share.disabled=false;}});</script></body></html>",
