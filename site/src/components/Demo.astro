---
import nativeEnglish from "../../../lilo-ui/src/lib/i18n/locales/en.json?raw";
import nativeFrench from "../../../lilo-ui/src/lib/i18n/locales/fr.json?raw";
import { demoMenus } from "../demo/menu";
import { copy, demoMessages } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import Flower from "./Flower.astro";

interface Props {
  lang: Locale;
  id?: string;
  mode?: "browser" | "terminal" | "mcp";
  autoplay?: boolean;
  deferred?: boolean;
  minimal?: boolean;
}

const {
  lang,
  id = "browser-demo",
  mode: initialMode = "browser",
  autoplay = false,
  deferred = false,
  minimal = false,
} = Astro.props;

const text = copy[lang];
const messages = demoMessages[lang];

const title = {
  browser: text.demoWindow,
  mcp: text.demoAgentWindow,
  terminal: text.demoTerminalWindow,
}[initialMode];

const viewportId = id === "browser-demo" ? "demo-viewport" : `${id}-viewport`;
const url = `/demo/?lang=${lang}${initialMode === "browser" ? "" : `&mode=${initialMode}`}${autoplay ? "&autoplay=1" : ""}`;

// SAFETY: these raw imports are the repository's native localization catalogs.
const { native } = JSON.parse(lang === "fr" ? nativeFrench : nativeEnglish) as {
  native: Record<string, string>;
};

const menuLabel = (label: string) => {
  const ordinal = /^Tab (?<ordinal>\d)$/u.exec(label)?.groups?.ordinal;

  if (label === "Exit Full Screen") {
    return text.demoExitFullscreen;
  }

  return ordinal
    ? native["Tab %d"].replace("%d", ordinal)
    : (native[label] ?? label);
};

const menuAlternates = new Map([
  ["sidebar", "Show Sidebar"],
  ["pin", "Unpin Tab"],
  ["mute", "Unmute Tab"],
  ["fullscreen", "Exit Full Screen"],
]);

const modes = [
  { action: "browser", label: text.demoBrowser },
  { action: "terminal", label: text.demoTerminal },
  { action: "mcp", label: text.demoMcp },
];
---

<div
  class="demo-shell"
  id={id}
  data-initial-mode={initialMode}
  role="group"
  aria-label={title}
  data-menu-locale={lang}
  data-mac-english={demoMessages.en.exploreMacNote}
  data-mac-french={demoMessages.fr.exploreMacNote}
  data-exit-english={copy.en.demoExitFullscreen}
  data-exit-french={copy.fr.demoExitFullscreen}
>
  <div class="demo-menubar">
    {minimal ? (
      <div class="demo-brand">
        <Flower id={`${id}-brand-flower-${lang}`} />
        <span>Lilo</span>
      </div>
    ) : (
      <>
        <nav class="mac-menubar" aria-label="Lilo" role="menubar">
          <span class="menu-flower" aria-hidden="true">
            <Flower id={`${id}-menu-flower-${lang}`} />
          </span>
          {demoMenus.map((menu, index) => (
            <details class="mac-menu" data-menu={menu.label}>
              <summary
                role="menuitem"
                aria-haspopup="menu"
                aria-expanded="false"
                tabindex={index === 0 ? 0 : -1}
              >
                <span data-menu-label={menu.label}>
                  {menuLabel(menu.label)}
                </span>
              </summary>
              <div
                class="menu-items"
                role="menu"
                aria-label={menuLabel(menu.label)}
                data-menu-name={menu.label}
              >
                {menu.children?.map((item) =>
                  "separator" in item ? (
                    <hr
                      role="separator"
                      data-developer-only={item.developerOnly || undefined}
                      data-terminal-only={item.terminalOnly || undefined}
                      hidden={item.developerOnly}
                    />
                  ) : item.dynamic === "spaces" ? (
                    <div
                      data-menu-list="spaces"
                      role="group"
                      aria-label={menuLabel("Spaces")}
                      data-menu-name="Spaces"
                    />
                  ) : item.children ? (
                    <details class="menu-submenu" data-submenu={item.label}>
                      <summary
                        role="menuitem"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        tabindex="-1"
                      >
                        <span class="menu-label" data-menu-label={item.label}>
                          {menuLabel(item.label)}
                        </span>
                        <span class="submenu-arrow" aria-hidden="true">
                          ›
                        </span>
                      </summary>
                      <div
                        class="menu-items"
                        role="menu"
                        aria-label={menuLabel(item.label)}
                        data-menu-name={item.label}
                        data-menu-list={item.dynamic}
                        data-empty-label={
                          item.emptyLabel
                            ? menuLabel(item.emptyLabel)
                            : undefined
                        }
                        data-empty-key={item.emptyLabel}
                      >
                        {item.children.map((child) =>
                          "separator" in child ? (
                            <hr role="separator" />
                          ) : child.dynamic === "extensions" ? (
                            <div
                              data-menu-list="extensions"
                              data-native-label={messages.exploreMacNote}
                              role="group"
                              aria-label={menuLabel("Extensions")}
                              data-menu-name="Extensions"
                            />
                          ) : (
                            <button
                              type="button"
                              role="menuitem"
                              tabindex="-1"
                              data-action={child.action}
                              data-shortcut={child.shortcutId}
                              data-native-only={child.macOnly || undefined}
                              disabled
                              title={
                                child.macOnly
                                  ? messages.exploreMacNote
                                  : undefined
                              }
                            >
                              <span
                                class="menu-label"
                                data-menu-label={child.label}
                              >
                                {menuLabel(child.label)}
                              </span>
                              {child.macOnly && (
                                <span class="menu-note" aria-hidden="true">
                                  Mac
                                </span>
                              )}
                              <kbd aria-hidden="true">{child.keys}</kbd>
                            </button>
                          )
                        )}
                      </div>
                    </details>
                  ) : (
                    <button
                      type="button"
                      role={
                        item.action === "bookmark"
                          ? "menuitemcheckbox"
                          : "menuitem"
                      }
                      aria-checked={
                        item.action === "bookmark" ? "false" : undefined
                      }
                      tabindex="-1"
                      data-action={item.action}
                      data-shortcut={item.shortcutId}
                      data-native-only={item.macOnly || undefined}
                      data-alternate={item.alternate || undefined}
                      data-developer-only={item.developerOnly || undefined}
                      data-default-label={menuLabel(item.label)}
                      data-label-key={item.label}
                      data-alternate-key={menuAlternates.get(item.action ?? "")}
                      data-alternate-label={menuLabel(
                        menuAlternates.get(item.action ?? "") ?? item.label
                      )}
                      disabled={item.action !== "fullscreen"}
                      hidden={item.developerOnly || Boolean(item.alternate)}
                      title={item.macOnly ? messages.exploreMacNote : undefined}
                    >
                      <span class="menu-label" data-menu-label={item.label}>
                        {menuLabel(item.label)}
                      </span>
                      {item.macOnly && (
                        <span class="menu-note" aria-hidden="true">
                          Mac
                        </span>
                      )}
                      <kbd aria-hidden="true">{item.keys}</kbd>
                    </button>
                  )
                )}
              </div>
            </details>
          ))}
        </nav>
        <div class="demo-modes" role="group" aria-label={text.demoWindow}>
          {modes.map((mode) => (
            <button
              type="button"
              data-action={mode.action}
              aria-pressed={mode.action === initialMode}
            >
              {mode.label}
            </button>
          ))}
        </div>
      </>
    )}
    <div class="demo-tools">
      {!minimal && (
        <button
          type="button"
          data-action="explore"
          aria-label={text.demoExplore}
          title={text.demoExplore}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="m15.5 8.5-2 5-5 2 2-5Z" />
          </svg>
        </button>
      )}
      <button
        type="button"
        data-action="reset"
        aria-label={text.demoReset}
        title={text.demoReset}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M3 11a9 9 0 1 1 2.6 6.4M3 4v7h7" />
        </svg>
      </button>
      <button
        type="button"
        data-action="fullscreen"
        data-enter-label={text.demoFullscreen}
        data-exit-label={text.demoExitFullscreen}
        aria-label={text.demoFullscreen}
        aria-controls={viewportId}
        aria-expanded="false"
        title={text.demoFullscreen}
      >
        <svg class="expand-enter" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
        </svg>
        <svg class="expand-exit" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M3 8h5V3m8 0v5h5M8 21v-5H3m18 0h-5v5" />
        </svg>
      </button>
    </div>
  </div>
  <div class="demo-viewport" id={viewportId}>
    <div class="demo-desktop">
      <iframe
        src={deferred ? undefined : url}
        data-src={deferred ? url : undefined}
        title={title}
        loading="lazy"
        allow="fullscreen"
      ></iframe>
    </div>
  </div>
  <noscript>
    <p>{text.demoNoScript}</p>
  </noscript>
</div>

<script>
  import { menuActionEnabled, parseMenuMessage } from "../demo/menu";
  import type {
    DemoMenuLabels,
    DemoMenuList,
    DemoMenuRow,
    DemoMenuState,
  } from "../demo/menu";

  const closeMenu = (menu: HTMLDetailsElement) => {
    menu.open = false;
    menu
      .querySelector(":scope > summary")
      ?.setAttribute("aria-expanded", "false");

    for (const child of menu.querySelectorAll<HTMLDetailsElement>(
      ".menu-submenu[open]"
    )) {
      child.open = false;
      child
        .querySelector(":scope > summary")
        ?.setAttribute("aria-expanded", "false");
    }
  };

  const menuItems = (panel: HTMLElement) =>
    [...panel.querySelectorAll<HTMLElement>("button, summary")].filter(
      (item) =>
        item.closest("[role='menu']") === panel &&
        !item.hidden &&
        !(item instanceof HTMLButtonElement && item.disabled)
    );

  const menuKeyboardContext = (
    menu: HTMLDetailsElement,
    active: HTMLElement
  ) => {
    const panel =
      active.closest<HTMLElement>("[role='menu']") ??
      menu.querySelector<HTMLElement>(":scope > .menu-items");

    if (!panel) {
      return null;
    }

    const parent = active.parentElement;

    const submenu =
      active.tagName === "SUMMARY" &&
      parent instanceof HTMLDetailsElement &&
      parent.classList.contains("menu-submenu")
        ? parent
        : null;

    return {
      active,
      containingSubmenu: submenu?.open
        ? submenu
        : panel.closest<HTMLDetailsElement>(".menu-submenu"),
      items: menuItems(panel),
      menu,
      rootSummary: menu.querySelector<HTMLElement>(":scope > summary"),
      submenu,
    };
  };

  type MenuKeyboardContext = NonNullable<
    ReturnType<typeof menuKeyboardContext>
  >;

  const terminalMenuActions = new Set([
    "newTerminal",
    "newTerminalBeside",
    "newTerminalBelow",
    "nextWaitingTerminal",
  ]);

  const syncMenuButton = (button: HTMLButtonElement, state: DemoMenuState) => {
    const action = button.dataset.action ?? "";
    button.disabled =
      action !== "fullscreen" && !menuActionEnabled(action, state);

    if (terminalMenuActions.has(action)) {
      button.hidden = state.terminalEnabled === false;
    }

    const alternate =
      (action === "sidebar" && !state.sidebarVisible) ||
      (action === "pin" && state.isPinned) ||
      (action === "mute" && state.isMuted);

    const label = alternate
      ? button.dataset.alternateLabel
      : button.dataset.defaultLabel;

    const text = button.querySelector(".menu-label");

    if (text && label && text.textContent !== label) {
      text.textContent = label;
    }

    if (action === "bookmark") {
      button.setAttribute("aria-checked", String(state.isBookmarked));
    }
  };

  interface MenuListContent {
    rows: DemoMenuRow[];
    action: string;
  }

  const menuContents = (
    state: DemoMenuState
  ): Record<DemoMenuList, MenuListContent> => ({
    extensions: { action: "", rows: state.extensions ?? [] },
    folders: {
      action: "moveToFolder",
      rows: state.isBookmarked ? [] : (state.folders ?? []),
    },
    moveSpaces: {
      action: "moveToSpace",
      rows: (state.spaces ?? []).filter((space) => !space.selected),
    },
    recentlyClosed: {
      action: "restoreClosedTab",
      rows: state.recentlyClosed ?? [],
    },
    recentlyVisited: {
      action: "openHistoryItem",
      rows: state.recentlyVisited ?? [],
    },
    spaces: { action: "selectSpace", rows: state.spaces ?? [] },
    terminals: { action: "selectTab", rows: state.terminals ?? [] },
  });

  const createMenuRow = (
    row: DemoMenuRow,
    index: number,
    name: string,
    action: string,
    panel: HTMLElement,
    state: DemoMenuState
  ) => {
    const button = document.createElement("button");
    button.type = "button";
    button.role = row.selected === undefined ? "menuitem" : "menuitemradio";
    button.tabIndex = -1;
    button.dataset.action = action;
    button.dataset.id = row.id;
    button.disabled =
      name === "extensions" ||
      ((name === "folders" || name === "moveSpaces") && !state.hasActiveTab);

    if (row.selected !== undefined) {
      button.setAttribute("aria-checked", String(row.selected));
    }

    const label = document.createElement("span");
    label.className = "menu-label";
    label.textContent = `${row.icon ? `${row.icon}  ` : ""}${row.title}`;
    button.append(label);

    if (name === "extensions") {
      button.dataset.nativeOnly = "true";
      button.title = panel.dataset.nativeLabel ?? "";
      const note = document.createElement("span");
      note.className = "menu-note";
      note.textContent = "Mac";
      note.setAttribute("aria-hidden", "true");
      button.append(note);
    }

    if (name === "spaces" && index < 9) {
      const keys = document.createElement("kbd");
      keys.setAttribute("aria-hidden", "true");
      keys.textContent = state.shortcutKeys
        ? (state.shortcutKeys[`space.select${index + 1}`] ?? "")
        : `⌃${index + 1}`;
      button.append(keys);
    }

    return button;
  };

  const renderMenuList = (
    panel: HTMLElement,
    name: string,
    content: MenuListContent,
    state: DemoMenuState
  ) => {
    const { action, rows } = content;

    const signature = JSON.stringify([
      rows,
      state.hasActiveTab,
      state.shortcutKeys,
      panel.dataset.emptyLabel,
      panel.dataset.nativeLabel,
    ]);

    if (panel.dataset.signature === signature) {
      return;
    }

    panel.dataset.signature = signature;

    const buttons = rows.map((row, index) =>
      createMenuRow(row, index, name, action, panel, state)
    );

    if (!buttons.length && panel.dataset.emptyLabel) {
      const empty = document.createElement("button");
      empty.type = "button";
      empty.role = "menuitem";
      empty.disabled = true;
      empty.textContent = panel.dataset.emptyLabel;
      buttons.push(empty);
    }

    panel.replaceChildren(...buttons);

    if (name === "extensions" && rows.length) {
      const separator = document.createElement("hr");
      separator.role = "separator";
      panel.append(separator);
    }
  };

  const applyMenuLabels = (demo: HTMLElement, message: DemoMenuLabels) => {
    const locale = message.locale ?? demo.dataset.menuLocale;
    const french = locale === "fr";

    const exitLabel = french
      ? demo.dataset.exitFrench
      : demo.dataset.exitEnglish;

    const nativeLabel = french
      ? demo.dataset.macFrench
      : demo.dataset.macEnglish;

    if (locale) {
      demo.dataset.menuLocale = locale;
    }

    const translate = (key: string) => {
      if (key === "Exit Full Screen") {
        return exitLabel ?? key;
      }

      const ordinal = /^Tab (?<ordinal>\d)$/u.exec(key)?.groups?.ordinal;

      return ordinal
        ? (message.labels["Tab %d"] ?? "Tab %d").replace("%d", ordinal)
        : (message.labels[key] ?? key);
    };

    for (const label of demo.querySelectorAll<HTMLElement>(
      "[data-menu-label]"
    )) {
      label.textContent = translate(label.dataset.menuLabel ?? "");
    }

    for (const panel of demo.querySelectorAll<HTMLElement>(
      "[data-menu-name]"
    )) {
      panel.setAttribute("aria-label", translate(panel.dataset.menuName ?? ""));
    }

    for (const button of demo.querySelectorAll<HTMLElement>(
      "[data-label-key]"
    )) {
      button.dataset.defaultLabel = translate(button.dataset.labelKey ?? "");

      if (button.dataset.alternateKey) {
        button.dataset.alternateLabel = translate(button.dataset.alternateKey);
      }
    }

    for (const panel of demo.querySelectorAll<HTMLElement>(
      "[data-empty-key]"
    )) {
      panel.dataset.emptyLabel = translate(panel.dataset.emptyKey ?? "");
    }

    if (nativeLabel) {
      for (const button of demo.querySelectorAll<HTMLElement>(
        "[data-native-only]"
      )) {
        button.title = nativeLabel;
      }

      for (const panel of demo.querySelectorAll<HTMLElement>(
        "[data-native-label]"
      )) {
        panel.dataset.nativeLabel = nativeLabel;
      }
    }
  };

  for (const demo of document.querySelectorAll<HTMLElement>(".demo-shell")) {
    const frame = demo.querySelector<HTMLIFrameElement>("iframe");
    const viewport = demo.querySelector<HTMLElement>(".demo-viewport");
    const desktop = demo.querySelector<HTMLElement>(".demo-desktop");

    const expand = demo.querySelector<HTMLButtonElement>(
      ".demo-tools [data-action='fullscreen']"
    );

    if (!(frame && viewport && desktop && expand)) {
      continue;
    }

    type DemoMessage =
      | string
      | { type: "lilo-demo:menu-command"; action: string; id: string };

    let ready = false;
    let visible = false;
    let pendingMessage: DemoMessage | null = null;
    let previousFocus: HTMLElement | null = null;
    const inertSiblings: HTMLElement[] = [];

    const send = (message: DemoMessage) => {
      frame.contentWindow?.postMessage(message, location.origin);
    };

    const syncVisibility = () => {
      send(
        visible && !document.hidden ? "lilo-demo:visible" : "lilo-demo:hidden"
      );
    };

    const syncAppearance = () => {
      const dark =
        document.documentElement.dataset.theme === "dark" ||
        (!document.documentElement.dataset.theme &&
          matchMedia("(prefers-color-scheme: dark)").matches);

      send(dark ? "lilo-demo:dark" : "lilo-demo:light");
    };

    const closeMenus = () => {
      for (const menu of demo.querySelectorAll<HTMLDetailsElement>(
        ".mac-menu[open], .menu-submenu[open]"
      )) {
        closeMenu(menu);
      }
    };

    const syncExpansion = () => {
      const expanded =
        document.fullscreenElement === demo ||
        Object.hasOwn(demo.dataset, "expanded");

      const label = expanded
        ? expand.dataset.exitLabel
        : expand.dataset.enterLabel;

      expand.setAttribute("aria-expanded", String(expanded));

      if (label) {
        expand.setAttribute("aria-label", label);
        expand.title = label;
      }

      const menuButton = demo.querySelector<HTMLButtonElement>(
        ".mac-menu [data-action='fullscreen']"
      );

      const menuLabel = expanded
        ? menuButton?.dataset.alternateLabel
        : menuButton?.dataset.defaultLabel;

      const menuText = menuButton?.querySelector(".menu-label");

      if (menuText && menuLabel) {
        menuText.textContent = menuLabel;
      }
    };

    const setExpanded = (expanded: boolean) => {
      if (Object.hasOwn(demo.dataset, "expanded") === expanded) {
        return;
      }

      demo.toggleAttribute("data-expanded", expanded);

      if (expanded) {
        previousFocus =
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : null;

        let branch: HTMLElement | null = demo;

        while (branch && branch !== document.body) {
          const parent: HTMLElement | null = branch.parentElement;

          if (!parent) {
            break;
          }

          for (const sibling of parent.children) {
            if (
              sibling instanceof HTMLElement &&
              sibling !== branch &&
              !sibling.inert
            ) {
              sibling.inert = true;
              inertSiblings.push(sibling);
            }
          }

          branch = parent;
        }

        expand.focus({ preventScroll: true });
      } else {
        for (const sibling of inertSiblings) {
          sibling.inert = false;
        }

        inertSiblings.length = 0;
        previousFocus?.focus({ preventScroll: true });
        previousFocus = null;
      }

      syncExpansion();
    };

    const fullscreen = async () => {
      if (Object.hasOwn(demo.dataset, "expanded")) {
        setExpanded(false);

        return;
      }

      if (document.fullscreenElement === demo) {
        await document.exitFullscreen();

        return;
      }

      try {
        await demo.requestFullscreen();
      } catch {
        setExpanded(true);
      }
    };

    const syncMode = (action: string) => {
      if (!["browser", "terminal", "mcp", "reset"].includes(action)) {
        return;
      }

      for (const button of demo.querySelectorAll<HTMLButtonElement>(
        ".demo-modes button"
      )) {
        button.setAttribute(
          "aria-pressed",
          String(
            button.dataset.action ===
              (action === "reset" ? demo.dataset.initialMode : action)
          )
        );
      }
    };

    const exitOnEscape = (event: KeyboardEvent) => {
      if (
        event.key === "Escape" &&
        !event.defaultPrevented &&
        Object.hasOwn(demo.dataset, "expanded")
      ) {
        event.preventDefault();
        setExpanded(false);
      }
    };

    const positionMenu = (menu: HTMLDetailsElement) => {
      const panel = menu.querySelector<HTMLElement>(":scope > .menu-items");

      if (!panel) {
        return;
      }

      delete menu.dataset.openLeft;
      panel.style.removeProperty("--menu-offset-y");
      const bounds = viewport.getBoundingClientRect();
      let rect = panel.getBoundingClientRect();

      if (rect.right > bounds.right - 5) {
        menu.dataset.openLeft = "";
        rect = panel.getBoundingClientRect();
      }

      const vertical = Math.min(0, bounds.bottom - rect.bottom - 6);
      panel.style.setProperty("--menu-offset-y", `${vertical}px`);
    };

    const openMenu = (menu: HTMLDetailsElement) => {
      menu.open = true;
      menu
        .querySelector(":scope > summary")
        ?.setAttribute("aria-expanded", "true");
      positionMenu(menu);
    };

    demo.addEventListener("click", (event) => {
      const submenu =
        event.target instanceof Element
          ? event.target.closest<HTMLDetailsElement>(".menu-submenu")
          : null;

      if (
        submenu &&
        event.target instanceof Element &&
        event.target.closest("summary") ===
          submenu.querySelector(":scope > summary")
      ) {
        event.preventDefault();
        openMenu(submenu);

        return;
      }

      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>("[data-action]")
          : null;

      const action = button?.dataset.action;

      if (!action || button?.disabled) {
        return;
      }

      closeMenus();

      if (action === "fullscreen") {
        void fullscreen();
      } else {
        syncMode(action);

        const message: DemoMessage = button?.dataset.id
          ? { action, id: button.dataset.id, type: "lilo-demo:menu-command" }
          : `lilo-demo:${action}`;

        if (ready) {
          send(message);
        } else {
          pendingMessage = message;
        }

        frame.focus();
      }
    });
    const menus = [...demo.querySelectorAll<HTMLDetailsElement>(".mac-menu")];

    const focusMenu = (menu: HTMLDetailsElement, first: boolean) => {
      closeMenus();
      openMenu(menu);

      const panel = menu.querySelector<HTMLElement>(":scope > .menu-items");

      if (panel) {
        (first ? menuItems(panel)[0] : menuItems(panel).at(-1))?.focus();
      }
    };

    let lastMenuState: DemoMenuState | null = null;

    const syncMenuState = (state: DemoMenuState) => {
      lastMenuState = state;

      for (const button of demo.querySelectorAll<HTMLButtonElement>(
        ".mac-menu button[data-action]:not([data-id])"
      )) {
        syncMenuButton(button, state);
      }

      for (const item of demo.querySelectorAll<HTMLElement>(
        "[data-developer-only]"
      )) {
        item.hidden = !state.developerTools;
      }

      for (const item of demo.querySelectorAll<HTMLElement>(
        "[data-terminal-only]"
      )) {
        item.hidden = state.terminalEnabled === false;
      }

      for (const item of demo.querySelectorAll<HTMLElement>(
        "[data-shortcut]"
      )) {
        const id = item.dataset.shortcut;
        const keys = item.querySelector("kbd");

        if (id && keys && state.shortcutKeys) {
          keys.textContent = state.shortcutKeys[id] ?? "";
        }
      }

      const develop = demo.querySelector<HTMLDetailsElement>(
        "[data-menu='Develop']"
      );

      if (develop) {
        develop.hidden = state.showDevelopMenu === false;

        if (develop.hidden) {
          closeMenu(develop);
        }
      }

      for (const [name, content] of Object.entries(menuContents(state))) {
        const panel = demo.querySelector<HTMLElement>(
          `[data-menu-list='${name}']`
        );

        if (panel) {
          renderMenuList(panel, name, content, state);
        }
      }

      syncExpansion();
    };

    const syncMenuLabels = (message: DemoMenuLabels) => {
      applyMenuLabels(demo, message);

      if (lastMenuState) {
        syncMenuState(lastMenuState);
      }
    };

    let typed = "";
    let typedAt = 0;

    const syncAlternates = (
      event: Pick<KeyboardEvent, "altKey" | "shiftKey">
    ) => {
      for (const alternate of demo.querySelectorAll<HTMLButtonElement>(
        "[data-alternate]"
      )) {
        const shown =
          alternate.dataset.alternate === "shift"
            ? event.shiftKey
            : event.altKey;

        alternate.hidden = !shown;
        const primary = alternate.previousElementSibling;

        if (primary instanceof HTMLButtonElement) {
          primary.hidden = shown;
        }
      }
    };

    document.addEventListener("keydown", syncAlternates, true);
    document.addEventListener("keyup", syncAlternates, true);
    window.addEventListener("blur", () =>
      syncAlternates({ altKey: false, shiftKey: false })
    );

    const focusChildMenu = (menu: HTMLDetailsElement) => {
      openMenu(menu);
      const panel = menu.querySelector<HTMLElement>(":scope > .menu-items");

      if (panel) {
        menuItems(panel)[0]?.focus();
      }
    };

    const moveVertical = (context: MenuKeyboardContext, key: string) => {
      openMenu(context.menu);
      const direction = key === "ArrowDown" ? 1 : -1;
      const index = context.items.indexOf(context.active);

      let next =
        (index + direction + context.items.length) % context.items.length;

      if (index === -1) {
        next = direction > 0 ? 0 : context.items.length - 1;
      }

      context.items[next]?.focus();
    };

    const moveBoundary = (context: MenuKeyboardContext, key: string) => {
      openMenu(context.menu);
      (key === "Home" ? context.items[0] : context.items.at(-1))?.focus();
    };

    const moveHorizontal = (
      context: MenuKeyboardContext,
      direction: number
    ) => {
      if (direction > 0 && context.submenu) {
        focusChildMenu(context.submenu);

        return;
      }

      if (direction < 0 && context.containingSubmenu) {
        closeMenu(context.containingSubmenu);
        context.containingSubmenu
          .querySelector<HTMLElement>(":scope > summary")
          ?.focus();

        return;
      }

      const visibleMenus = menus.filter((candidate) =>
        candidate.checkVisibility()
      );

      const next =
        visibleMenus[
          (visibleMenus.indexOf(context.menu) +
            direction +
            visibleMenus.length) %
            visibleMenus.length
        ];

      if (context.menu.open) {
        focusMenu(next, true);
      } else {
        next.querySelector<HTMLElement>(":scope > summary")?.focus();
      }
    };

    const activateMenuSummary = (context: MenuKeyboardContext) => {
      if (!context.submenu && context.active !== context.rootSummary) {
        return false;
      }

      focusChildMenu(context.submenu ?? context.menu);

      return true;
    };

    const typeAhead = (context: MenuKeyboardContext, event: KeyboardEvent) => {
      if (
        event.key.length !== 1 ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey
      ) {
        return;
      }

      event.preventDefault();
      const now = performance.now();
      typed =
        now - typedAt < 600 && typed !== event.key
          ? typed + event.key
          : event.key;
      typedAt = now;
      const needle = typed.toLocaleLowerCase();
      const index = context.items.indexOf(context.active);

      const match = [
        ...context.items.slice(index + 1),
        ...context.items.slice(0, index + 1),
      ].find((item) =>
        item.textContent?.trim().toLocaleLowerCase().startsWith(needle)
      );

      match?.focus();
    };

    const handleMenuKeyDown = (event: KeyboardEvent) => {
      const menu = event.currentTarget;

      if (
        !(menu instanceof HTMLDetailsElement) ||
        !(event.target instanceof HTMLElement)
      ) {
        return;
      }

      if (event.key === "Tab") {
        closeMenus();

        return;
      }

      if (event.key === "Escape" && !menu.open) {
        return;
      }

      const context = menuKeyboardContext(menu, event.target);

      if (!context) {
        return;
      }

      switch (event.key) {
        case "ArrowDown":
        case "ArrowUp": {
          moveVertical(context, event.key);
          break;
        }

        case "Home":
        case "End": {
          moveBoundary(context, event.key);
          break;
        }

        case "Enter":
        case " ": {
          if (!activateMenuSummary(context)) {
            return;
          }

          break;
        }

        case "ArrowRight": {
          moveHorizontal(context, 1);
          break;
        }

        case "ArrowLeft": {
          moveHorizontal(context, -1);
          break;
        }

        case "Escape": {
          const selected = context.containingSubmenu ?? menu;
          closeMenu(selected);
          selected.querySelector<HTMLElement>(":scope > summary")?.focus();
          break;
        }

        default: {
          typeAhead(context, event);

          return;
        }
      }

      event.preventDefault();
    };

    const handleMenuToggle = (event: Event) => {
      const menu = event.currentTarget;

      if (!(menu instanceof HTMLDetailsElement)) {
        return;
      }

      typed = "";
      menu
        .querySelector(":scope > summary")
        ?.setAttribute("aria-expanded", String(menu.open));

      if (menu.open) {
        for (const other of menus) {
          if (other !== menu) {
            closeMenu(other);
          }
        }

        positionMenu(menu);
      }
    };

    for (const menu of menus) {
      menu.addEventListener("toggle", handleMenuToggle);
      menu.addEventListener("keydown", handleMenuKeyDown);
      menu.addEventListener("pointerenter", () => {
        if (menus.some((candidate) => candidate.open)) {
          closeMenus();
          openMenu(menu);
        }
      });
      menu.addEventListener("focusin", () => {
        for (const root of menus) {
          const summary = root.querySelector<HTMLElement>(":scope > summary");

          if (summary) {
            summary.tabIndex = root === menu ? 0 : -1;
          }
        }
      });
      menu.addEventListener("pointerover", (event) => {
        if (
          event.pointerType !== "mouse" ||
          !(event.target instanceof Element)
        ) {
          return;
        }

        const target = event.target.closest<HTMLElement>("button, summary");
        const panel = target?.closest<HTMLElement>("[role='menu']");

        if (!panel) {
          return;
        }

        for (const child of panel.children) {
          if (child instanceof HTMLDetailsElement) {
            if (child.querySelector(":scope > summary") === target) {
              openMenu(child);
            } else {
              closeMenu(child);
            }
          }
        }
      });

      for (const submenu of menu.querySelectorAll<HTMLDetailsElement>(
        ".menu-submenu"
      )) {
        submenu.addEventListener("toggle", () => {
          submenu
            .querySelector(":scope > summary")
            ?.setAttribute("aria-expanded", String(submenu.open));

          if (submenu.open) {
            positionMenu(submenu);
          }
        });
      }
    }

    document.addEventListener("pointerdown", (event) => {
      syncAlternates(event);

      if (
        !(event.target instanceof Element && event.target.closest(".mac-menu"))
      ) {
        closeMenus();
      }
    });
    window.addEventListener("message", (event) => {
      if (
        event.origin !== location.origin ||
        event.source !== frame.contentWindow
      ) {
        return;
      }

      if (event.data === "lilo-demo:ready") {
        ready = true;
        syncAppearance();
        syncVisibility();

        if (pendingMessage) {
          send(pendingMessage);
          pendingMessage = null;
        }
      }

      const menuMessage = parseMenuMessage(event);

      if (menuMessage?.type === "lilo-demo:menu-state") {
        syncMenuState(menuMessage);
      }

      if (menuMessage?.type === "lilo-demo:menu-labels") {
        syncMenuLabels(menuMessage);
      }

      if (event.data === "lilo-demo:interaction") {
        closeMenus();
      }

      for (const mode of ["browser", "terminal", "mcp"]) {
        if (event.data === `lilo-demo:mode:${mode}`) {
          syncMode(mode);
        }
      }

      if (event.data === "lilo-demo:fullscreen") {
        void fullscreen();
      }
    });
    new ResizeObserver(([entry]) => {
      if (!entry) {
        return;
      }

      const { height, width } = entry.contentRect;
      const scale = Math.min(1, width / 900, height / 640);

      if (scale <= 0) {
        return;
      }

      desktop.style.width = `${width / scale}px`;
      desktop.style.height = `${height / scale}px`;
      desktop.style.transform = `scale(${scale})`;
    }).observe(viewport);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;

        if (visible && !frame.hasAttribute("src") && frame.dataset.src) {
          frame.src = frame.dataset.src;
        }

        syncVisibility();
      },
      { threshold: 0 }
    ).observe(demo);
    new MutationObserver(syncAppearance).observe(document.documentElement, {
      attributeFilter: ["data-theme"],
      attributes: true,
    });
    matchMedia("(prefers-color-scheme: dark)").addEventListener(
      "change",
      syncAppearance
    );
    document.addEventListener("visibilitychange", syncVisibility);
    document.addEventListener("fullscreenchange", syncExpansion);
    document.addEventListener("keydown", exitOnEscape);

    const bindFrameKeyboard = () => {
      frame.contentDocument?.addEventListener("keydown", exitOnEscape);
    };

    frame.addEventListener("load", bindFrameKeyboard);
    bindFrameKeyboard();
  }
</script>

