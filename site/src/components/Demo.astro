---
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

interface Space {
  id: string;
  icon: string;
  name: string;
  host: string;
  path: string;
  favs: [icon: string, color: string][];
  folders: [name: string, locked?: boolean][];
  tabs: [name: string, color: string, icon: string, state?: "on" | "agent"][];
}

const { lang } = Astro.props;
const text = copy[lang];

const spaces = [
  {
    favs: [
      ["✉", "#5b8def"],
      ["31", "#e5534b"],
      ["◉", "#f4a93b"],
      ["⌖", "#34a853"],
    ],
    folders: [[text.demoHome], [text.demoRenovation], [text.demoTrips, true]],
    host: "slowtravel.blog",
    icon: "🏠",
    id: "perso",
    name: "Perso",
    path: text.demoTravelPath,
    tabs: [
      [text.demoArticleTitle, "#f4bb8c", "✦", "on"],
      [text.demoRecipes, "#9bd3b4", "☘"],
      [text.demoFlat, "#92a8ff", "⌂"],
      ["~/Projects/lilo", "#1a1a2e", "$"],
    ],
  },
  {
    favs: [
      ["✉", "#5b8def"],
      ["◷", "#6a4be0"],
      ["▤", "#2f9e8f"],
      ["✎", "#e0825f"],
    ],
    folders: [[text.demoLaunch], [text.demoHiring], [text.demoReviews]],
    host: "tracker.team",
    icon: "💼",
    id: "work",
    name: text.demoWork,
    path: "/web/inbox",
    tabs: [
      [text.demoInboxTab, "#6a4be0", "◷", "on"],
      [text.demoPullRequest, "#24292f", "❖"],
      [text.demoCheckoutTest, "#d97757", "A", "agent"],
      ["~/shop", "#1a1a2e", "$"],
    ],
  },
  {
    favs: [
      ["♫", "#e5534b"],
      ["♪", "#34a853"],
      ["◉", "#629aa9"],
      ["★", "#a238ff"],
    ],
    folders: [["Setlists"], [text.demoGear]],
    host: "radio.fm",
    icon: "🎧",
    id: "music",
    name: text.demoMusic,
    path: "/late-night",
    tabs: [
      [text.demoPlaylist, "#b39df4", "♫", "on"],
      [text.demoConcerts, "#026cdf", "★"],
      [text.demoSynth, "#555", "☷"],
    ],
  },
] satisfies Space[];

const edges = [
  ["left", text.demoTabsLeft],
  ["right", text.demoTabsRight],
  ["top", text.demoTabsTop],
  ["bottom", text.demoTabsBottom],
] as const;

const issues = [
  [text.demoCheckoutIssue, "WEB-482", "prog"],
  [text.demoOnboardingIssue, "WEB-479", ""],
  [text.demoPricingIssue, "WEB-471", "done"],
  [text.demoLoginIssue, "WEB-468", ""],
  [text.demoChangelogIssue, "WEB-460", "done"],
];
---

<div class="demo">
<div class="window" id="browser-demo" role="group" aria-label={text.demoWindow}>
  <!-- Right and bottom keep a bar over the page for the traffic lights: shown by the edge picked below. -->
  <div class="page-bar" aria-hidden="true">
    <div class="lights">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="navs">
      <span>&#8249;</span>
      <span>&#8250;</span>
    </div>
    <div class="addr">
      {spaces.map((space) => (
        <span data-demo-space={space.id}>
          <b>{space.host}</b>
          {space.path}
        </span>
      ))}
    </div>
  </div>
  <div class="sb">
    <div class="chrome-row" aria-hidden="true">
      <div class="lights">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <div class="navs">
        <span>&#9707;</span>
        <span>&#8249;</span>
        <span>&#8250;</span>
        <span>&#8635;</span>
      </div>
    </div>
    <div class="addr" aria-hidden="true">
      {spaces.map((space) => (
        <span data-demo-space={space.id}>
          <b>{space.host}</b>
          {space.path}
        </span>
      ))}
    </div>
    {spaces.map((space) => (
      <div class="space-content" data-demo-space={space.id} aria-hidden="true">
        <div class="shead">
          {space.icon} {space.name}
          <em>&#9788;</em>
        </div>
        <div class="favs">
          {space.favs.map(([icon, color]) => (
            <span>
              <i style={`background:${color}`}>{icon}</i>
            </span>
          ))}
        </div>
        <div>
          {space.folders.map(([name, locked]) => (
            <div class="row-item">
              <span class="fi"></span>
              <span class="tt">{name}</span>
              {locked && <span class="lock">🔒</span>}
            </div>
          ))}
        </div>
        <div class="divider"></div>
        <div>
          {space.tabs.map(([name, color, icon, state]) => (
            <div class={`row-item ${state ?? ""}`}>
              <span class="fav" style={`background:${color}`}>
                {icon}
              </span>
              <span class="tt">{name}</span>
              {state === "on" && <span class="x">✕</span>}
              {state === "agent" && <span class="who">agent</span>}
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="row-item newtab" aria-hidden="true">
      <span>+</span>
      <span>{text.demoNewTab}</span>
    </div>
    <div class="spacebar">
      <div class="spaces" role="radiogroup" aria-label={text.demoSpaces}>
        {spaces.map((space, index) => (
          <>
            <input
              type="radio"
              name="demo-space"
              id={`demo-space-${space.id}`}
              value={space.id}
              checked={index === 0}
              aria-label={text.demoSpace.replace("{name}", space.name)}
            />
            <label
              for={`demo-space-${space.id}`}
              title={space.name}
              aria-hidden="true"
            >
              {space.icon}
            </label>
          </>
        ))}
      </div>
      <button
        class="playback"
        type="button"
        aria-label={text.demoAutoplay}
        aria-pressed="true"
        title={text.demoAutoplay}
        hidden
      >
        <svg
          aria-hidden="true"
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path class="pause" d="M4 3h3v10H4zM9 3h3v10H9z" />
          <path class="play" d="m5 2 9 6-9 6z" />
        </svg>
      </button>
    </div>
  </div>
  <div class="view" aria-hidden="true">
    <div class="article" data-demo-space="perso">
      <div class="cover">
        <span>
          {text.demoArticleCoverFirst}
          <br />
          {text.demoArticleCoverSecond}
        </span>
      </div>
      <div class="body">
        <span class="meta">{text.demoArticleMeta}</span>
        <p>{text.demoArticleText}</p>
        <div class="days">
          {[text.demoFirstDay, text.demoSecondDay, text.demoThirdDay].map(
            (day, index) => (
              <div>
                <b>
                  {text.demoDay} {index + 1}
                </b>
                {day}
              </div>
            )
          )}
        </div>
      </div>
    </div>
    <div class="split" data-demo-space="work">
      <div class="issues">
        <b class="ttl">{text.demoInbox}</b>
        {issues.map(([title, id, state]) => (
          <div class="issue">
            <i class={state}></i>
            <span>{title}</span>
            <small>{id}</small>
          </div>
        ))}
      </div>
      <div class="term">
        <div>
          <b>~/shop</b> claude
        </div>
        <div class="dim">{text.demoConnected}</div>
        <div class="ag">navigate localhost:3000/checkout</div>
        <div class="ag">click "{text.demoPayNow}"</div>
        <div class="ok">{text.demoReproduced}</div>
        <div class="ag">screenshot</div>
        <div class="ok">{text.demoFixReady}</div>
      </div>
    </div>
    <div class="player" data-demo-space="music">
      <div class="art"></div>
      <div class="now">
        <small>{text.demoNowPlaying}</small>
        <b>{text.demoPlaylist}</b>
        <span class="track-count">{text.demoTrackCount}</span>
        <div class="prog">
          <i></i>
        </div>
        <div class="ctrl">
          <span>⏮</span>
          <span class="pp">❙❙</span>
          <span>⏭</span>
        </div>
        <ol>
          <li>Night drive</li>
          <li>Soft focus</li>
          <li>After hours</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<div class="edges" role="radiogroup" aria-label={text.demoTabsEdge}>
  <span class="edges-label" aria-hidden="true">{text.demoTabsEdge}</span>
  {edges.map(([edge, label], index) => (
    <>
      <input
        type="radio"
        name="demo-tabs"
        id={`demo-tabs-${edge}`}
        value={edge}
        checked={index === 0}
        aria-label={label}
      />
      <label for={`demo-tabs-${edge}`} title={label} aria-hidden="true">
        <span class={`edge-glyph ${edge}`}></span>
      </label>
    </>
  ))}
</div>
</div>


<script>
  import { gsap } from "gsap";
  import { CustomEase } from "gsap/CustomEase";

  const demo = document.querySelector<HTMLElement>("#browser-demo");

  if (demo) {
    gsap.registerPlugin(CustomEase);
    gsap.config({ autoSleep: 1 });

    const ease = CustomEase.create("space-slide", "0.22,1,0.36,1");

    const controls = [
      ...demo.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
    ];

    const group = demo.querySelector<HTMLElement>(".spaces");
    const edgePicker = demo.parentElement?.querySelector<HTMLElement>(".edges");
    const playback = demo.querySelector<HTMLButtonElement>(".playback");
    const motion = gsap.matchMedia();

    motion.add("(prefers-reduced-motion: no-preference)", () => {
      let current = controls.findIndex((control) => control.checked);
      let autoplay = true;
      let visible = false;
      let transition: gsap.core.Tween | undefined;

      const show = (index: number) => {
        transition?.revert();

        const direction =
          (index - current + controls.length) % controls.length === 1
            ? 36
            : -36;

        const control = controls[index];

        control.checked = true;
        current = index;

        const space = `[data-demo-space="${control.value}"]`;

        const panes = demo.querySelectorAll(
          `.space-content${space} > :not(.divider), .view > ${space}`
        );

        transition = gsap.fromTo(
          panes,
          { autoAlpha: 0, x: direction },
          {
            autoAlpha: 1,
            clearProps: "transform,opacity,visibility",
            duration: 0.42,
            ease,
            stagger: 0.035,
            x: 0,
          }
        );
      };

      const cycle = gsap.timeline({ paused: true, repeat: -1 });
      cycle.call(() => show((current + 1) % controls.length), [], 3.2);

      const syncPlayback = () => {
        const playing = autoplay && visible && !document.hidden;
        cycle.paused(!playing);

        if (!playing) {
          transition?.progress(1);
        }

        playback?.setAttribute("aria-pressed", String(autoplay));
      };

      const stop = () => {
        autoplay = false;
        syncPlayback();
      };

      const select = () => {
        stop();
        show(controls.findIndex((control) => control.checked));
      };

      const togglePlayback = () => {
        autoplay = !autoplay;
        cycle.restart().pause();
        syncPlayback();
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = entry.intersectionRatio >= 0.2;
          syncPlayback();
        },
        { threshold: 0.2 }
      );

      observer.observe(demo);
      group?.addEventListener("pointerdown", stop);
      group?.addEventListener("focusin", stop);
      group?.addEventListener("change", select);
      edgePicker?.addEventListener("pointerdown", stop);
      edgePicker?.addEventListener("focusin", stop);
      playback?.addEventListener("click", togglePlayback);
      document.addEventListener("visibilitychange", syncPlayback);

      if (playback) {
        playback.hidden = false;
      }

      return () => {
        observer.disconnect();
        group?.removeEventListener("pointerdown", stop);
        group?.removeEventListener("focusin", stop);
        group?.removeEventListener("change", select);
        edgePicker?.removeEventListener("pointerdown", stop);
        edgePicker?.removeEventListener("focusin", stop);
        playback?.removeEventListener("click", togglePlayback);
        document.removeEventListener("visibilitychange", syncPlayback);
        transition?.revert();

        if (playback) {
          playback.hidden = true;
        }
      };
    });
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 20px;
    justify-items: center;
  }

  .demo .window {
    width: 100%;
  }

  /* Hidden until an edge needs it: right and bottom keep the traffic lights and the address there. */
  .page-bar {
    display: none;
    align-items: center;
    gap: 16px;
    padding: 0 10px 0 12px;
    min-width: 0;
  }

  .page-bar .navs {
    margin-left: 0;
  }

  .page-bar .addr {
    flex: 1;
    max-width: 360px;
    margin: 0 auto;
    padding: 5px 12px;
    justify-content: center;
  }

  .demo:has(#demo-tabs-right:checked) .window,
  .demo:has(#demo-tabs-top:checked) .window,
  .demo:has(#demo-tabs-bottom:checked) .window {
    padding: 0 8px 8px;
  }

  .demo:has(#demo-tabs-right:checked) .window {
    grid-template-columns: minmax(0, 1fr) 252px;
    grid-template-rows: 38px minmax(0, 1fr);
    grid-template-areas: "bar sb" "view sb";
    padding: 0 0 8px 8px;
  }

  .demo:has(#demo-tabs-top:checked) .window {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 48px minmax(0, 1fr);
    grid-template-areas: "sb" "view";
  }

  .demo:has(#demo-tabs-bottom:checked) .window {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 38px minmax(0, 1fr) 62px;
    grid-template-areas: "bar" "view" "sb";
  }

  .demo:has(#demo-tabs-right:checked) .page-bar,
  .demo:has(#demo-tabs-bottom:checked) .page-bar {
    display: flex;
    grid-area: bar;
  }

  .demo:has(:is(#demo-tabs-right, #demo-tabs-top, #demo-tabs-bottom):checked) .sb {
    grid-area: sb;
  }

  .demo:has(:is(#demo-tabs-right, #demo-tabs-top, #demo-tabs-bottom):checked) .view {
    grid-area: view;
  }

  /* On the right and at the bottom the page bar holds the lights, the history and the address. */
  .demo:has(:is(#demo-tabs-right, #demo-tabs-bottom):checked) .sb > .chrome-row,
  .demo:has(:is(#demo-tabs-right, #demo-tabs-bottom):checked) .sb > .addr {
    display: none;
  }

  /* A strip: one row, the active tab carrying the address. */
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .sb {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 0 4px;
    overflow: hidden;
  }

  .demo:has(#demo-tabs-bottom:checked) .sb {
    margin-top: 8px;
    padding: 0 8px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .demo:has(#demo-tabs-top:checked) .sb > .chrome-row {
    flex: none;
  }

  .demo:has(#demo-tabs-top:checked) .sb > .addr {
    flex: 0 1 240px;
    min-width: 120px;
    margin: 0;
    padding: 6px 10px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .space-content {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    overflow: hidden;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .space-content > div {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .shead {
    flex: none;
    padding: 6px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.16);
    letter-spacing: 0;
    text-transform: none;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .shead em,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .spacebar,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .newtab span:last-child,
  .demo:has(#demo-tabs-top:checked) .row-item.on {
    display: none;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs {
    display: flex;
    gap: 0;
    margin: 0;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs span {
    width: 28px;
    height: 28px;
    background: transparent;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .divider {
    flex: none;
    width: 1px;
    height: 18px;
    margin: 0 4px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .row-item {
    flex: 0 1 150px;
    min-width: 32px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .row-item.on {
    flex: 0 0 200px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .newtab {
    flex: none;
  }

  /* Each edge has its own keyframes so a new pick restarts the settle-in. */
  .demo:has(#demo-tabs-left:checked) .window > * { animation: edge-left 0.42s cubic-bezier(0.22, 1, 0.36, 1); }
  .demo:has(#demo-tabs-right:checked) .window > * { animation: edge-right 0.42s cubic-bezier(0.22, 1, 0.36, 1); }
  .demo:has(#demo-tabs-top:checked) .window > * { animation: edge-top 0.42s cubic-bezier(0.22, 1, 0.36, 1); }
  .demo:has(#demo-tabs-bottom:checked) .window > * { animation: edge-bottom 0.42s cubic-bezier(0.22, 1, 0.36, 1); }

  @keyframes edge-left { from { opacity: 0; transform: translateX(-10px); } }
  @keyframes edge-right { from { opacity: 0; transform: translateX(10px); } }
  @keyframes edge-top { from { opacity: 0; transform: translateY(-8px); } }
  @keyframes edge-bottom { from { opacity: 0; transform: translateY(8px); } }

  @media (prefers-reduced-motion: reduce) {
    .demo .window > * {
      animation: none !important;
    }
  }

  .edges {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 4px 4px 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 0 0 0.5px var(--line), 0 6px 18px color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--ink-2);
    font: 600 13px/1 var(--sys);
  }

  .edges-label {
    margin-right: 6px;
  }

  .edges input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .edges label {
    width: 40px;
    height: 32px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .edges input:checked + label {
    background: var(--accent);
    color: var(--on-brand);
  }

  .edges input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .edge-glyph {
    position: relative;
    width: 22px;
    height: 16px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1.4px currentColor;
  }

  .edge-glyph::after {
    content: "";
    position: absolute;
    border-radius: 1.5px;
    background: currentColor;
  }

  .edge-glyph.left::after { left: 2px; top: 2px; bottom: 2px; width: 6px; }
  .edge-glyph.right::after { right: 2px; top: 2px; bottom: 2px; width: 6px; }
  .edge-glyph.top::after { left: 2px; right: 2px; top: 2px; height: 4px; }
  .edge-glyph.bottom::after { left: 3px; right: 3px; bottom: 2px; height: 4px; }

  /* Phones keep the sidebar demo: a strip has no room on a narrow window. */
  @media (max-width: 900px) {
    .edges {
      display: none;
    }
  }

  /* Perso: a travel article */
  .article {
    display: grid;
    grid-template-rows: 46% auto;
  }
  .article .cover {
    background: linear-gradient(160deg, #f4bb8c, #f1a7a5 45%, #92a8ff);
    position: relative;
  }
  .article .cover span {
    position: absolute;
    left: 32px;
    bottom: 22px;
    font: 800 34px/1.05 var(--round);
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }
  .article .body {
    padding: 22px 32px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .article .meta {
    font-size: 12px;
    color: #6b6b80;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .article p {
    font-size: 14px;
    line-height: 1.6;
    color: #3b3b4f;
    max-width: 52ch;
  }
  .article .days {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .article .days div {
    border-radius: 10px;
    background: #f6f3fb;
    padding: 12px;
    font-size: 12.5px;
    color: #4b4b63;
  }
  .article .days b {
    display: block;
    font-size: 13.5px;
    color: #1f2328;
    margin-bottom: 2px;
  }
  /* Work: issue list split with a terminal */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 6px;
    background: var(--frame);
  }
  .issues {
    background: #fff;
    padding: 18px 20px;
    display: grid;
    gap: 4px;
    align-content: start;
    border-radius: 10px 0 0 10px;
  }
  .issues .ttl {
    display: block;
    margin: 0 0 8px;
    font: 700 16px/1.2 var(--sys);
  }
  .issue {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 9px 6px;
    border-bottom: 1px solid #eeecf3;
    font-size: 13px;
  }
  .issue i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #c3c1d0;
  }
  .issue i.prog {
    border-color: #f4bb8c;
    background: conic-gradient(#f4bb8c 50%, transparent 0);
  }
  .issue i.done {
