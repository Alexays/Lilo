---
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

interface Space {
  id: string;
  icon: string;
  name: string;
  host: string;
  path: string;
  favs: [icon: string, color: string][];
  folders: [name: string, locked?: boolean][];
  tabs: [name: string, color: string, icon: string, state?: "on" | "agent"][];
}

const { lang } = Astro.props;
const text = copy[lang];

const spaces = [
  {
    favs: [
      ["✉", "#5b8def"],
      ["31", "#e5534b"],
      ["◉", "#f4a93b"],
      ["⌖", "#34a853"],
    ],
    folders: [[text.demoHome], [text.demoRenovation], [text.demoTrips, true]],
    host: "slowtravel.blog",
    icon: "🏠",
    id: "perso",
    name: "Perso",
    path: text.demoTravelPath,
    tabs: [
      [text.demoArticleTitle, "#f4bb8c", "✦", "on"],
      [text.demoRecipes, "#9bd3b4", "☘"],
      [text.demoFlat, "#92a8ff", "⌂"],
      ["~/Projects/lilo", "#1a1a2e", "$"],
    ],
  },
  {
    favs: [
      ["✉", "#5b8def"],
      ["◷", "#6a4be0"],
      ["▤", "#2f9e8f"],
      ["✎", "#e0825f"],
    ],
    folders: [[text.demoLaunch], [text.demoHiring], [text.demoReviews]],
    host: "tracker.team",
    icon: "💼",
    id: "work",
    name: text.demoWork,
    path: "/web/inbox",
    tabs: [
      [text.demoInboxTab, "#6a4be0", "◷", "on"],
      [text.demoPullRequest, "#24292f", "❖"],
      [text.demoCheckoutTest, "#d97757", "A", "agent"],
      ["~/shop", "#1a1a2e", "$"],
    ],
  },
  {
    favs: [
      ["♫", "#e5534b"],
      ["♪", "#34a853"],
      ["◉", "#629aa9"],
      ["★", "#a238ff"],
    ],
    folders: [["Setlists"], [text.demoGear]],
    host: "radio.fm",
    icon: "🎧",
    id: "music",
    name: text.demoMusic,
    path: "/late-night",
    tabs: [
      [text.demoPlaylist, "#b39df4", "♫", "on"],
      [text.demoConcerts, "#026cdf", "★"],
      [text.demoSynth, "#555", "☷"],
    ],
  },
] satisfies Space[];

const edges = [
  ["left", text.demoTabsLeft],
  ["right", text.demoTabsRight],
  ["top", text.demoTabsTop],
  ["bottom", text.demoTabsBottom],
] as const;

const issues = [
  [text.demoCheckoutIssue, "WEB-482", "prog"],
  [text.demoOnboardingIssue, "WEB-479", ""],
  [text.demoPricingIssue, "WEB-471", "done"],
  [text.demoLoginIssue, "WEB-468", ""],
  [text.demoChangelogIssue, "WEB-460", "done"],
];
---

<div class="demo">
  <div
    class="window"
    id="browser-demo"
    role="group"
    aria-label={text.demoWindow}
  >
    <!-- Right and bottom keep a bar over the page for the traffic lights: shown by the edge picked below. -->
    <div class="page-bar" aria-hidden="true">
      <div class="lights">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <div class="navs">
        <span>&#8249;</span>
        <span>&#8250;</span>
        <span>&#8635;</span>
      </div>
      <div class="addr">
        {spaces.map((space) => (
          <span data-demo-space={space.id}>
            <b>{space.host}</b>
            {space.path}
          </span>
        ))}
      </div>
    </div>
    <div class="sb">
      <div class="chrome-row" aria-hidden="true">
        <div class="lights">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="navs">
          <span class="tabs-toggle"></span>
          <span>&#8249;</span>
          <span>&#8250;</span>
          <span>&#8635;</span>
        </div>
      </div>
      <div class="addr" aria-hidden="true">
        {spaces.map((space) => (
          <span data-demo-space={space.id}>
            <b>{space.host}</b>
            {space.path}
          </span>
        ))}
      </div>
      {spaces.map((space) => (
        <div
          class="space-content"
          data-demo-space={space.id}
          aria-hidden="true"
        >
          <div class="shead">
            {space.icon} {space.name}
            <em>&#9788;</em>
            <svg class="chevron" width="10" height="10" viewBox="0 0 10 10">
              <path
                d="M2 3.5l3 3 3-3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </div>
          <div class="favs">
            {space.favs.map(([icon, color]) => (
              <span>
                <i style={`background:${color}`}>{icon}</i>
              </span>
            ))}
          </div>
          <div>
            {space.folders.map(([name, locked]) => (
              <div class="row-item">
                <span class="fi"></span>
                <span class="tt">{name}</span>
                {locked && <span class="lock">🔒</span>}
              </div>
            ))}
          </div>
          <div class="divider"></div>
          <div>
            {space.tabs.map(([name, color, icon, state]) => (
              <div class={`row-item ${state ?? ""}`}>
                <span class="fav" style={`background:${color}`}>
                  {icon}
                </span>
                {state === "on" && <b class="site">{space.host}</b>}
                <span class="tt">{name}</span>
                {state === "on" && <span class="x">✕</span>}
                {state === "agent" && <span class="who">agent</span>}
              </div>
            ))}
          </div>
        </div>
      ))}
      <div class="row-item newtab" aria-hidden="true">
        <span>+</span>
        <span>{text.demoNewTab}</span>
      </div>
      <span class="strip-toggle" aria-hidden="true">
        <span class="tabs-toggle"></span>
      </span>
      <div class="spacebar">
        <div class="spaces" role="radiogroup" aria-label={text.demoSpaces}>
          {spaces.map((space, index) => (
            <>
              <input
                type="radio"
                name="demo-space"
                id={`demo-space-${space.id}`}
                value={space.id}
                checked={index === 0}
                aria-label={text.demoSpace.replace("{name}", space.name)}
              />
              <label
                for={`demo-space-${space.id}`}
                title={space.name}
                aria-hidden="true"
              >
                {space.icon}
              </label>
            </>
          ))}
        </div>
        <button
          class="playback"
          type="button"
          aria-label={text.demoAutoplay}
          aria-pressed="true"
          title={text.demoAutoplay}
          hidden
        >
          <svg
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="currentColor"
          >
            <path class="pause" d="M4 3h3v10H4zM9 3h3v10H9z" />
            <path class="play" d="m5 2 9 6-9 6z" />
          </svg>
        </button>
      </div>
    </div>
    <div class="view" aria-hidden="true">
      <div class="article" data-demo-space="perso">
        <div class="cover">
          <span>
            {text.demoArticleCoverFirst}
            <br />
            {text.demoArticleCoverSecond}
          </span>
        </div>
        <div class="body">
          <span class="meta">{text.demoArticleMeta}</span>
          <p>{text.demoArticleText}</p>
          <div class="days">
            {[text.demoFirstDay, text.demoSecondDay, text.demoThirdDay].map(
              (day, index) => (
                <div>
                  <b>
                    {text.demoDay} {index + 1}
                  </b>
                  {day}
                </div>
              )
            )}
          </div>
        </div>
      </div>
      <div class="split" data-demo-space="work">
        <div class="issues">
          <b class="ttl">{text.demoInbox}</b>
          {issues.map(([title, id, state]) => (
            <div class="issue">
              <i class={state}></i>
              <span>{title}</span>
              <small>{id}</small>
            </div>
          ))}
        </div>
        <div class="term">
          <div>
            <b>~/shop</b> claude
          </div>
          <div class="dim">{text.demoConnected}</div>
          <div class="ag">navigate localhost:3000/checkout</div>
          <div class="ag">click "{text.demoPayNow}"</div>
          <div class="ok">{text.demoReproduced}</div>
          <div class="ag">screenshot</div>
          <div class="ok">{text.demoFixReady}</div>
        </div>
      </div>
      <div class="player" data-demo-space="music">
        <div class="art"></div>
        <div class="now">
          <small>{text.demoNowPlaying}</small>
          <b>{text.demoPlaylist}</b>
          <span class="track-count">{text.demoTrackCount}</span>
          <div class="prog">
            <i></i>
          </div>
          <div class="ctrl">
            <span>⏮</span>
            <span class="pp">❙❙</span>
            <span>⏭</span>
          </div>
          <ol>
            <li>Night drive</li>
            <li>Soft focus</li>
            <li>After hours</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <div class="edges" role="radiogroup" aria-label={text.demoTabsEdge}>
    <span class="edges-label" aria-hidden="true">
      {text.demoTabsEdge}
    </span>
    {edges.map(([edge, label], index) => (
      <>
        <input
          type="radio"
          name="demo-tabs"
          id={`demo-tabs-${edge}`}
          value={edge}
          checked={index === 0}
          aria-label={label}
        />
        <label for={`demo-tabs-${edge}`} title={label} aria-hidden="true">
          <span class={`edge-glyph edge-${edge}`}></span>
        </label>
      </>
    ))}
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { CustomEase } from "gsap/CustomEase";

  const demo = document.querySelector<HTMLElement>("#browser-demo");

  if (demo) {
    gsap.registerPlugin(CustomEase);
    gsap.config({ autoSleep: 1 });

    const ease = CustomEase.create("space-slide", "0.22,1,0.36,1");

    const controls = [
      ...demo.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
    ];

    const group = demo.querySelector<HTMLElement>(".spaces");
    const edgePicker = demo.parentElement?.querySelector<HTMLElement>(".edges");
    const playback = demo.querySelector<HTMLButtonElement>(".playback");
    const motion = gsap.matchMedia();

    motion.add("(prefers-reduced-motion: no-preference)", () => {
      let current = controls.findIndex((control) => control.checked);
      let autoplay = true;
      let visible = false;
      let transition: gsap.core.Tween | undefined;

      const show = (index: number) => {
        transition?.revert();

        const direction =
          (index - current + controls.length) % controls.length === 1
            ? 36
            : -36;

        const control = controls[index];

        control.checked = true;
        current = index;

        const space = `[data-demo-space="${control.value}"]`;

        const panes = demo.querySelectorAll(
          `.space-content${space} > :not(.divider), .view > ${space}`
        );

        transition = gsap.fromTo(
          panes,
          { autoAlpha: 0, x: direction },
          {
            autoAlpha: 1,
            clearProps: "transform,opacity,visibility",
            duration: 0.42,
            ease,
            stagger: 0.035,
            x: 0,
          }
        );
      };

      const cycle = gsap.timeline({ paused: true, repeat: -1 });
      cycle.call(() => show((current + 1) % controls.length), [], 3.2);

      const syncPlayback = () => {
        const playing = autoplay && visible && !document.hidden;
        cycle.paused(!playing);

        if (!playing) {
          transition?.progress(1);
        }

        playback?.setAttribute("aria-pressed", String(autoplay));
      };

      const stop = () => {
        autoplay = false;
        syncPlayback();
      };

      const select = () => {
        stop();
        show(controls.findIndex((control) => control.checked));
      };

      const togglePlayback = () => {
        autoplay = !autoplay;
        cycle.restart().pause();
        syncPlayback();
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          visible = entry.intersectionRatio >= 0.2;
          syncPlayback();
        },
        { threshold: 0.2 }
      );

      observer.observe(demo);
      group?.addEventListener("pointerdown", stop);
      group?.addEventListener("focusin", stop);
      group?.addEventListener("change", select);
      edgePicker?.addEventListener("pointerdown", stop);
      edgePicker?.addEventListener("focusin", stop);
      playback?.addEventListener("click", togglePlayback);
      document.addEventListener("visibilitychange", syncPlayback);

      if (playback) {
        playback.hidden = false;
      }

      return () => {
        observer.disconnect();
        group?.removeEventListener("pointerdown", stop);
        group?.removeEventListener("focusin", stop);
        group?.removeEventListener("change", select);
        edgePicker?.removeEventListener("pointerdown", stop);
        edgePicker?.removeEventListener("focusin", stop);
        playback?.removeEventListener("click", togglePlayback);
        document.removeEventListener("visibilitychange", syncPlayback);
        transition?.revert();

        if (playback) {
          playback.hidden = true;
        }
      };
    });
  }
</script>

<style>
  .demo {
    display: grid;
    gap: 20px;
    justify-items: center;
  }

  .demo .window {
    width: 100%;
  }

  /* Hidden until an edge needs it: right and bottom keep the traffic lights and the address there. */
  .page-bar {
    display: none;
    align-items: center;
    gap: 16px;
    padding: 0 10px 0 12px;
    min-width: 0;
  }

  .page-bar .navs {
    margin-left: 0;
  }

  .page-bar .navs span:first-child {
    margin-right: 0;
  }

  .page-bar .addr {
    flex: 1;
    max-width: 480px;
    height: 32px;
    margin: 0 auto;
    padding: 0 12px;
    align-items: center;
    justify-content: center;
  }

  /* Drawn on the edge the tabs sit on, as the app's own toggle is. */
  .tabs-toggle {
    position: relative;
    align-self: center;
    width: 15px;
    height: 12px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1.3px currentColor;
  }

  .tabs-toggle::after {
    content: "";
    position: absolute;
    left: 2.5px;
    top: 2.5px;
    bottom: 2.5px;
    width: 3px;
    border-radius: 1px;
    background: currentColor;
  }

  .demo:has(#demo-tabs-right:checked) .tabs-toggle::after {
    left: auto;
    right: 2.5px;
  }

  .demo:has(#demo-tabs-top:checked) .tabs-toggle::after {
    right: 2.5px;
    bottom: auto;
    width: auto;
    height: 2.5px;
  }

  .demo:has(#demo-tabs-bottom:checked) .tabs-toggle::after {
    right: 2.5px;
    top: auto;
    width: auto;
    height: 2.5px;
  }

  .shead .chevron,
  .row-item .site,
  .strip-toggle {
    display: none;
  }

  .demo:has(#demo-tabs-right:checked) .window,
  .demo:has(#demo-tabs-top:checked) .window,
  .demo:has(#demo-tabs-bottom:checked) .window {
    padding: 0 8px 8px;
  }

  .demo:has(#demo-tabs-right:checked) .window {
    grid-template-columns: minmax(0, 1fr) 252px;
    grid-template-rows: 40px minmax(0, 1fr);
    grid-template-areas: "bar sb" "view sb";
    padding: 0 0 8px 8px;
  }

  .demo:has(#demo-tabs-top:checked) .window {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 40px minmax(0, 1fr);
    grid-template-areas: "sb" "view";
  }

  /* The dock floats 10px off the window's edges, so the window drops its bottom inset. */
  .demo:has(#demo-tabs-bottom:checked) .window {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 40px minmax(0, 1fr) 72px;
    grid-template-areas: "bar" "view" "sb";
    padding: 0 8px;
  }

  .demo:has(#demo-tabs-right:checked) .page-bar,
  .demo:has(#demo-tabs-bottom:checked) .page-bar {
    display: flex;
    grid-area: bar;
  }

  .demo:has(:is(#demo-tabs-right, #demo-tabs-top, #demo-tabs-bottom):checked)
    .sb {
    grid-area: sb;
  }

  .demo:has(:is(#demo-tabs-right, #demo-tabs-top, #demo-tabs-bottom):checked)
    .view {
    grid-area: view;
  }

  /* The address lives in the page bar on the right and at the bottom, in the active pill at the top. */
  .demo:has(:is(#demo-tabs-right, #demo-tabs-top, #demo-tabs-bottom):checked)
    .sb
    > .addr,
  .demo:has(#demo-tabs-bottom:checked) .sb > .chrome-row {
    display: none;
  }

  /* On the right the sidebar's top row keeps only the tabs toggle. */
  .demo:has(#demo-tabs-right:checked) .sb > .chrome-row .lights,
  .demo:has(#demo-tabs-right:checked)
    .sb
    > .chrome-row
    .navs
    span:not(.tabs-toggle),
  .demo:has(#demo-tabs-top:checked) .sb > .chrome-row .tabs-toggle {
    display: none;
  }

  .demo:has(#demo-tabs-right:checked) .sb > .chrome-row .tabs-toggle {
    margin-right: 4px;
  }

  /* A strip: one row of 32px pills with 6px corners, the tabs toggle at its end. */
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .sb {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 0 2px 0 4px;
    overflow: hidden;
  }

  .demo:has(#demo-tabs-bottom:checked) .sb {
    margin: 10px 2px;
    padding: 0 10px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .demo:has(#demo-tabs-top:checked) .sb > .chrome-row {
    flex: none;
    margin-right: 6px;
  }

  /* Pills past the end fade out, as the app's strip does before it scrolls. */
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .space-content {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to left, transparent, black 24px);
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked)
    .space-content
    > div {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .shead {
    flex: none;
    height: 32px;
    gap: 7px;
    padding: 0 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .shead .chevron {
    display: block;
    flex: none;
    opacity: 0.7;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .shead em,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .lock,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .spacebar,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked)
    .newtab
    span:last-child {
    display: none;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs span {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: transparent;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs::after,
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .divider {
    content: "";
    flex: none;
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: rgba(255, 255, 255, 0.14);
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .row-item {
    position: relative;
    flex: 0 1 170px;
    min-width: 32px;
    height: 32px;
    gap: 8px;
    padding: 0 8px;
    border-radius: 6px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .row-item.on {
    flex: 0 0 260px;
  }

  /* Folders keep their whole name, packed 2px apart like the pinned row. */
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .favs + div {
    flex: none;
    gap: 2px;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked)
    .favs
    + div
    .row-item {
    flex: none;
    gap: 7px;
    padding: 0 9px;
  }

  /* A hairline between two resting pills, none beside the active one. */
  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked)
    .divider
    + div
    > .row-item:not(.on)
    + .row-item:not(.on)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 1px;
    background: rgba(255, 255, 255, 0.14);
  }

  .demo:has(#demo-tabs-top:checked) .row-item .site {
    display: block;
    flex: none;
    font-weight: 600;
  }

  .demo:has(#demo-tabs-top:checked) .row-item.on .tt {
    color: rgba(255, 255, 255, 0.65);
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .newtab {
    flex: none;
    width: 32px;
    padding: 0;
    justify-content: center;
  }

  .demo:has(:is(#demo-tabs-top, #demo-tabs-bottom):checked) .strip-toggle {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Each edge has its own keyframes so a new pick restarts the settle-in. */
  .demo:has(#demo-tabs-left:checked) .window > * {
    animation: edge-left 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo:has(#demo-tabs-right:checked) .window > * {
    animation: edge-right 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo:has(#demo-tabs-top:checked) .window > * {
    animation: edge-top 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .demo:has(#demo-tabs-bottom:checked) .window > * {
    animation: edge-bottom 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes edge-left {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
  }
  @keyframes edge-right {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
  }
  @keyframes edge-top {
    from {
      opacity: 0;
