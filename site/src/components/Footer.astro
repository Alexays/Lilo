---
import { copy, localizedPath } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import Flower from "./Flower.astro";
import GitHubIcon from "./GitHubIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = copy[lang];
const otherLang = lang === "fr" ? "en" : "fr";

const page =
  Astro.url.pathname === "/404/"
    ? ""
    : Astro.url.pathname.replace(/^\/fr(?=\/)/u, "").slice(1);
---

<footer class="foot">
  <div class="wrap foot-frame">
    <div class="foot-main">
      <div class="foot-brand">
        <a class="logo" href={localizedPath(lang)} aria-label={text.home}>
          <Flower id="footer-flower" />
          Lilo
        </a>
        <p>{text.footerDescription}</p>
        <div class="foot-links">
          <a href="https://github.com/Alexays/Lilo">
            <GitHubIcon />
            <span class="foot-social-name">GitHub</span>
          </a>
          <a href="https://discord.gg/NyJRAapk76">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
              width="20"
              height="20"
            >
              <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
            </svg>
            <span class="foot-social-name">Discord</span>
          </a>
        </div>
      </div>
      <nav class="foot-nav" aria-label={text.footerNavigation}>
        <div>
          <h2>{text.getStarted}</h2>
          <ul role="list">
            <li>
              <a href="https://github.com/Alexays/Lilo/releases/latest/download/Lilo.dmg">
                {text.download}
              </a>
            </li>
            <li>
              <a href={localizedPath(lang, "moving/")}>{text.movingTitle}</a>
            </li>
            <li>
              <a href={localizedPath(lang, "changelog/")}>{text.changelog}</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>{text.resources}</h2>
          <ul role="list">
            <li>
              <a href="https://github.com/Alexays/Lilo/blob/main/docs/README.md">
                {text.documentation}
              </a>
            </li>
            <li>
              <a href="https://github.com/Alexays/Lilo/issues">
                {text.reportBug}
              </a>
            </li>
            <li>
              <a href="https://github.com/Alexays/Lilo/blob/main/PRIVACY.md">
                {text.privacy}
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="foot-bottom">
      <p>{text.footer}</p>
      <a
        href={localizedPath(otherLang, page)}
        lang={otherLang}
        hreflang={otherLang}
      >
        {otherLang === "fr" ? "Français" : "English"}
      </a>
    </div>
  </div>
</footer>

<style>
  .foot {
    color: var(--ink-2);
    font-size: 14px;
    border-top: 1px solid var(--line);
  }
  .foot-frame {
    padding-left: max(24px, env(safe-area-inset-left, 0px));
    padding-right: max(24px, env(safe-area-inset-right, 0px));
    border-inline: 1px solid var(--line);
  }
  .foot-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    padding-block: 56px;
  }
  .foot-brand {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 16px;
  }
  .foot-brand .logo {
    color: var(--ink);
  }
  .foot-brand p {
    max-width: 32ch;
    line-height: 1.7;
  }
  .foot-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-left: -12px;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
  }
  .foot-links :global(svg) {
    flex: none;
  }
  .foot-social-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .foot-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .foot-nav h2 {
    color: var(--ink);
    font: 600 13px/1.5 var(--sys);
    letter-spacing: normal;
  }
  .foot-nav ul {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .foot-nav a {
    display: inline-block;
    padding-block: 4px;
  }
  .foot-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 20px max(24px, env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    font-size: 12px;
  }
  .foot-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 13px;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .foot-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-block: 36px;
    }
    .foot-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
