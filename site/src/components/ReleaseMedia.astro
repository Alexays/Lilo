---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import type { ReleasePresentation } from "../../captures/remotion/presentation";
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  media: ReleasePresentation["media"][string];
  poster: ImageMetadata;
  recording?: string;
  alternative: string;
  lang: Locale;
}

const { media, poster, recording, alternative, lang } = Astro.props;
const text = copy[lang];
---

<figure
  class:list={[
    "capture",
    media.kind === "video" ? "release-recording" : "release-image",
  ]}
  data-video={media.kind === "video" ? "true" : undefined}
  data-play={text.releasePlayRecording}
  data-stop={text.releaseStopRecording}
  data-replay={text.releaseReplayRecording}
>
  <Image
    src={poster}
    alt={alternative}
    widths={[560, 1120, 1280]}
    sizes="(max-width: 700px) calc(100vw - 32px), 560px"
  />
  {media.kind === "video" && (
    <>
      <video
        data-src={recording}
        poster={poster.src}
        width={media.width}
        height={media.height}
        muted
        playsinline
        preload="none"
        aria-label={alternative}
        hidden
      ></video>
      <button
        class="recording-toggle"
        type="button"
        aria-label={text.releasePlayRecording}
        aria-pressed="false"
        hidden
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path class="play" d="m9 5 11 7-11 7Z" />
          <rect class="stop" x="6" y="6" width="12" height="12" rx="2" />
        </svg>
      </button>
    </>
  )}
</figure>

<script>
  const motion = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-video]")) {
    const video = root.querySelector("video");
    const poster = root.querySelector("img");
    const button = root.querySelector("button");

    if (!video || !poster || !button) {
      continue;
    }

    let played = false;
    let generation = 0;

    const stop = () => {
      generation += 1;
      video.pause();
      video.hidden = true;
      poster.hidden = false;
      button.setAttribute("aria-pressed", "false");
      button.setAttribute(
        "aria-label",
        played ? (root.dataset.replay ?? "") : (root.dataset.play ?? "")
      );
    };

    const play = async () => {
      if (document.hidden) {
        return;
      }

      generation += 1;
      const current = generation;
      played = true;
      video.src ||= video.dataset.src ?? "";
      video.currentTime = 0;
      video.hidden = false;
      poster.hidden = true;
      button.setAttribute("aria-pressed", "true");
      button.setAttribute("aria-label", root.dataset.stop ?? "");

      try {
        await video.play();

        if (current !== generation) {
          video.pause();
        }
      } catch {
        if (current === generation) {
          stop();
        }
      }
    };

    button.hidden = false;
    button.addEventListener("click", () => {
      if (video.hidden) {
        play();
      } else {
        stop();
      }
    });
    video.addEventListener("ended", stop);
    video.addEventListener("error", stop);
    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          stop();
        } else if (
          entry.intersectionRatio >= 0.5 &&
          !played &&
          !motion.matches
        ) {
          play();
        }
      },
      { threshold: [0, 0.5] }
    ).observe(root);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stop();
      }
    });
    motion.addEventListener("change", () => {
      if (motion.matches) {
        stop();
      }
    });
  }
</script>

<style>
  .capture {
    position: relative;
    display: block;
    margin: 24px 0 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--sidebar);
  }
  img,
  video {
    display: block;
    width: 100%;
    height: auto;
  }
  [hidden] {
    display: none;
  }
  button {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .stop,
  [aria-pressed="true"] .play {
    display: none;
  }
  [aria-pressed="true"] .stop {
    display: block;
  }
</style>
