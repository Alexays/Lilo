---
import { Image } from "astro:assets";

import darkReader from "../assets/extensions/dark-reader.png";
import keepa from "../assets/extensions/keepa.png";
import reactDevtools from "../assets/extensions/react-devtools.png";
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = copy[lang];

const extensions = [
  {
    description: text.keepaDescription,
    icon: keepa,
    name: "Keepa",
    path: "keepa-amazon-price-tracke/neebplgakaahbhdphmkckjjcegoiijjo",
  },
  {
    description: text.darkReaderDescription,
    icon: darkReader,
    name: "Dark Reader",
    path: "dark-reader/eimadpbcbfnmbkopoojfekhnkhdbieeh",
  },
  {
    description: text.reactDevtoolsDescription,
    icon: reactDevtools,
    name: "React Developer Tools",
    path: "react-developer-tools/fmkadmapgofadopljbjfkapdkoienihi",
  },
];
---

<div class="store" role="group" aria-label={text.extensionStore}>
  {extensions.map((extension) => (
    <div class="store-row">
      <Image
        class="ei"
        src={extension.icon}
        alt=""
        width={48}
        height={48}
        densities={[1, 2]}
      />
      <div>
        <b>{extension.name}</b>
        <small>{extension.description}</small>
      </div>
      <a
        class="store-link"
        href={`https://chromewebstore.google.com/detail/${extension.path}`}
        aria-label={text.extensionLink.replace("{name}", extension.name)}
      >
        {text.viewExtension}
      </a>
    </div>
  ))}
  <p class="store-hint">{text.extensionStoreHint}</p>
</div>

<style>
  .store {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 22px;
    display: grid;
    gap: 16px;
  }
  .store-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .store-row :global(.ei) {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    flex: none;
    object-fit: contain;
  }
  .store-row div {
    min-width: 0;
    flex: 1;
  }
  .store-row b {
    display: block;
  }
  .store-row small {
    color: var(--ink-2);
  }
  .store-link {
    background: #1a73e8;
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 9px 16px;
    font: 600 14px/1 var(--sys);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
  }
  .store-hint {
    font-size: 13px;
    color: var(--ink-2);
    min-height: 1.5em;
  }
  .store-link:hover {
    background: #155fc1;
  }
  @media (max-width: 640px) {
    .store {
      padding: 16px;
    }
    .store-row {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      align-items: start;
      gap: 10px;
    }
    .store-link {
      grid-column: 2;
      justify-self: start;
      padding: 9px 12px;
      font-size: 13px;
    }
  }
</style>
