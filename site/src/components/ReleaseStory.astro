---
import type { Locale } from "../lib/i18n";
import type { ReleaseStory } from "../lib/release-stories";
import ReleaseRecording from "./ReleaseRecording.astro";

interface Props {
  lang: Locale;
  story: ReleaseStory;
}

const { lang, story } = Astro.props;
---

<div class="release-story" lang={lang}>
  <h3 class="story-title">{story.title[lang]}</h3>
  <p class="story-introduction">{story.introduction[lang]}</p>
  <div class="highlights">
    {story.highlights.map((highlight) => (
      <section
        class:list={[
          "release-highlight",
          {
            lead:
              highlight.id === story.capture?.highlight || !!highlight.capture,
          },
        ]}
        id={`v${story.version}-${highlight.id}`}
        lang={lang}
        aria-labelledby={`v${story.version}-${highlight.id}-title`}
      >
        <h4 id={`v${story.version}-${highlight.id}-title`}>
          {highlight.title[lang]}
        </h4>
        <p>{highlight.body[lang]}</p>
        {highlight.action && (
          <a
            class="highlight-action recording-action"
            href={highlight.action.href[lang]}
          >
            {highlight.action.label[lang]}
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 12h16m-6-6 6 6-6 6" />
            </svg>
          </a>
        )}
        {story.capture && highlight.id === story.capture.highlight && (
          <ReleaseRecording capture={story.capture} lang={lang} story={story} />
        )}
        {highlight.capture && (
          <ReleaseRecording
            capture={highlight.capture}
            lang={lang}
            story={story}
          />
        )}
      </section>
    ))}
  </div>
</div>

<style>
  .story-title {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .story-introduction {
    max-width: 58ch;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 36px;
  }
  .release-highlight {
    min-width: 0;
  }
  .lead {
    grid-column: 1 / -1;
  }
  h4 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .release-highlight p {
    margin-top: 10px;
    color: var(--ink-2);
    line-height: 1.65;
  }
  .highlight-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .highlight-action:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (max-width: 700px) {
    .highlights {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
