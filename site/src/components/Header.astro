---
import { copy, localizedPath } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import Flower from "./Flower.astro";
import GitHubIcon from "./GitHubIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = copy[lang];
const home = localizedPath(lang);
const path = Astro.url.pathname;

const links = [
  [`${home}#native`, "WebKit"],
  [`${home}#extensions`, "Extensions"],
  [`${home}#privacy`, text.privacy],
  [`${home}#build`, "Terminal"],
  [`${home}#agents`, "Agents"],
  [`${home}moving/`, text.movingTitle],
  [
    "https://github.com/Alexays/Lilo/blob/main/docs/README.md",
    text.documentation,
  ],
  [`${home}changelog/`, text.changelog],
];
---

<header class="site-header">
  <div class="wrap nav">
    <div class="nav-brand">
      <details class="mobile-nav">
        <summary class="icon-button" aria-label={text.toggleNavigation}>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav aria-label={text.navigation}>
          {links.map(([href, label]) => (
            <a href={href} aria-current={path === href ? "page" : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </details>
      <a class="logo" href={home} aria-label={text.home}>
        <Flower />
        Lilo
      </a>
    </div>
    <nav class="desktop-nav" aria-label={text.navigation}>
      {links.map(([href, label]) => (
        <a href={href} aria-current={path === href ? "page" : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="nav-tools">
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label={text.toggleTheme}
        title={text.toggleTheme}
      >
        <svg
          class="theme-sun"
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42m0-14.14-1.42 1.42m-11.3 11.3-1.42 1.42" />
        </svg>
        <svg
          class="theme-moon"
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" />
        </svg>
      </button>
      <a
        class="icon-button"
        href="https://github.com/Alexays/Lilo"
        aria-label="GitHub"
        title="GitHub"
      >
        <GitHubIcon />
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-nav");
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  try {
    const theme = localStorage.getItem("lilo-theme");

    if (theme === "light" || theme === "dark") {
      root.dataset.theme = theme;
    }
  } catch {
    // Storage can be unavailable in private browsing.
  }

  root.dataset.themeReady = "";

  toggle?.addEventListener("click", () => {
    const dark = root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;

    const theme = dark ? "light" : "dark";
    root.dataset.theme = theme;

    try {
      localStorage.setItem("lilo-theme", theme);
    } catch {
      // The toggle still works when the preference cannot be saved.
    }
  });

  document.addEventListener("click", ({ target }) => {
    if (
      menu?.open &&
      target instanceof Element &&
      (!menu.contains(target) || target.closest("a"))
    ) {
      menu.open = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
</script>
