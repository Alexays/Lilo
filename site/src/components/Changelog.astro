---
import Layout from "../layouts/Layout.astro";
import { copy } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { releases, stories } from "../lib/release-entries";
import PageSection from "./PageSection.astro";
import ReleaseEntry from "./ReleaseEntry.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const text = copy[lang];
---

<Layout
  lang={lang}
  title={text.changelogTitle}
  description={text.changelogDescription}
  hero={{
    heading: `${text.heading} ${text.headingAccent}`,
    description: text.introduction,
    tag: text.releases,
    note: text.languageNote,
  }}
>
  <PageSection>
    {releases.map((release, index) => (
      <ReleaseEntry
        lang={lang}
        latest={index === 0}
        release={release}
        story={stories.get(release.version)}
      />
    ))}
  </PageSection>
</Layout>
