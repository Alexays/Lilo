{
  "name": "lilo-site",
  "private": true,
  "type": "module",
  "scripts": {
    "capture:release": "node captures/release-capture.ts",
    "capture:import": "node captures/import-native.ts",
    "dev": "astro dev --host 127.0.0.1",
    "preview": "wrangler dev --ip 127.0.0.1",
    "build": "astro build && python3 generate.py",
    "check": "ultracite check && NODE_PATH=./node_modules astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts tests/demo/*.test.ts && python3 -B -m unittest discover -s tests",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "fix": "ultracite fix",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "astro": "7.4.2",
    "just-bash": "3.6.0",
    "marked": "18.1.1",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "sharp": "0.35.5",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "ultracite": "8.0.2",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
