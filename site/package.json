{
  "name": "lilo-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "wrangler dev --ip 127.0.0.1",
    "build": "astro build && python3 generate.py",
    "check": "ultracite check && astro check",
    "test": "node --test tests/*.test.ts && python3 -B -m unittest discover -s tests",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.2",
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "ultracite": "8.0.2",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici@7.29.1": "7.30.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
