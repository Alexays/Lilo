<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>fr</string>
        <string>es</string>
        <string>zh-Hans</string>
        <string>pt-BR</string>
        <string>ru</string>
        <string>uk</string>
        <string>ja</string>
        <string>de</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>Lilo</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>CFBundleName</key>
    <string>$(LILO_APP_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>$(LILO_APP_NAME)</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>HTML document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>XHTML document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.xhtml</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Document viewable in a browser</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
                <string>public.svg-image</string>
                <string>public.image</string>
                <string>public.plain-text</string>
                <string>com.apple.webarchive</string>
            </array>
        </dict>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>fr.arouillard.lilo.web</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
            </array>
            <key>LSHandlerRank</key>
            <string>Default</string>
        </dict>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>SUFeedURL</key>
    <string>https://github.com/Alexays/Lilo/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>$(SPARKLE_PUBLIC_ED_KEY)</string>
    <!-- Checks and downloads in the background from the first launch, without Sparkle's permission prompt. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <true/>
    <key>SURequireSignedFeed</key>
    <true/>
    <!-- Sparkle refuses to start a signed-feed updater without it. -->
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSAppleScriptEnabled</key>
    <true/>
    <key>OSAScriptingDefinition</key>
    <string>Lilo.sdef</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Alexis Rouillard. MIT License.</string>
    <key>NSCameraUsageDescription</key>
    <string>This website requests access to your camera.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>This website requests access to your microphone.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Lilo shares the sound of your Mac when a call asks for it with your screen.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Lilo connects to devices on your local network, such as a router or printer, when you open their pages or an extension looks for them.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>This website requests speech recognition to turn what you say into text.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>This website requests access to your location.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <key>NSUserActivityTypes</key>
    <array>
        <string>NSUserActivityTypeBrowsingWeb</string>
    </array>
</dict>
</plist>
