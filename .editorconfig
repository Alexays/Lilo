root = true

[*.{swift,ts,js,mjs,svelte,css,md,yml,yaml,sh}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Package.resolved]
indent_style = space
indent_size = 2

[*.{swift,sh}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
