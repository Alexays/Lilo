{
  "name": "lilo-ui",
  "private": true,
  "version": "0.10.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite dev --host localhost --port 5173 --strictPort",
    "watch": "vite build --watch",
    "build": "vite build",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ . & eslint=$!; npm run check; check=$?; wait $eslint && [ $check -eq 0 ]"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "lightningcss": "1.33.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "terser": "5.51.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4"
  }
}
