<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Debug build's own daemon: it never replaces the installed app's (fr.arouillard.lilo.power.plist). -->
	<key>Label</key>
	<string>fr.arouillard.lilo.debug.power</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/LiloPowerHelper</string>
	<key>MachServices</key>
	<dict>
		<key>fr.arouillard.lilo.debug.power</key>
		<true/>
	</dict>
	<!-- At boot it undoes what a run cut short left in its state file, then exits when idle. -->
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>fr.arouillard.lilo.debug</string>
	</array>
</dict>
</plist>
